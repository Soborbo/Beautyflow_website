---
/**
 * HeroImage - FULL pattern for full-bleed hero images
 * Use: Full-width hero sections, landing page banners
 * Pattern: 100vw - uses FULL widths array
 * LCP: Only ONE per page should have priority=true
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { buildResponsivePreload } from './responsivePreload';

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
  class?: string;
  /**
   * Media query (pl. `(max-width: 1023px)`), amelyen ez a kép a LCP-elem.
   * Ilyenkor `<link rel="preload">` megy ki rá, a kép maga pedig `lazy` marad —
   * lásd `responsivePreload.ts`. Kizárja a `priority`-t.
   */
  preloadMedia?: string;
}

const { src, alt, priority = false, class: className, preloadMedia } = Astro.props;

if (priority && preloadMedia) {
  throw new Error(
    '[HeroImage] `priority` és `preloadMedia` egyszerre nem adható meg: az első ' +
      'minden törésponton eager+high-ra állítja a képet, a második pont ezt váltja ' +
      'ki törésponthoz kötött preloaddal. Válassz egyet.'
  );
}

// FULL pattern from astro-images skill
// Added 480 for better small mobile coverage
const widths = [480, 640, 750, 828, 1080, 1200, 1920, 2048, 2560];
const sizes = '100vw';
const quality = 60;

const preload = preloadMedia
  ? await buildResponsivePreload({ src, widths, sizes, quality, media: preloadMedia })
  : null;
---

{preload && (
  <link
    rel="preload"
    as="image"
    type="image/avif"
    fetchpriority="high"
    imagesrcset={preload.imagesrcset}
    imagesizes={preload.imagesizes}
    media={preload.media}
  />
)}

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp', 'jpg']}
  quality={quality}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding={priority ? undefined : 'async'}
/>
