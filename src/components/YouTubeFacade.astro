---
// Lightweight YouTube facade: shows a thumbnail image first and only
// loads the (autoplaying) iframe once the visitor clicks. Keeps the
// initial page load light by avoiding the embed until it's wanted.
interface Props {
  videoId: string;
  title: string;
  class?: string;
}

const { videoId, title, class: className = '' } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
---

<div
  class:list={['yt-facade relative aspect-video w-full overflow-hidden shadow-lg', className]}
  data-video-id={videoId}
  data-title={title}
>
  <button
    type="button"
    class="yt-facade-btn group absolute inset-0 h-full w-full cursor-pointer"
    aria-label={title}
  >
    <img
      src={thumb}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      width="1280"
      height="720"
    />
    <span class="absolute inset-0 bg-black/10 transition-colors group-hover:bg-black/20"></span>
    <span
      class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/70 transition-transform group-hover:scale-110"
    >
      <svg class="ml-1 h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((wrapper) => {
    const btn = wrapper.querySelector<HTMLButtonElement>('.yt-facade-btn');
    btn?.addEventListener('click', () => {
      const videoId = wrapper.dataset.videoId;
      const title = wrapper.dataset.title ?? '';
      if (!videoId) return;

      const iframe = document.createElement('iframe');
      iframe.className = 'absolute inset-0 h-full w-full';
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.title = title;
      iframe.setAttribute('frameborder', '0');
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.allowFullscreen = true;

      wrapper.replaceChildren(iframe);
    });
  });
</script>
