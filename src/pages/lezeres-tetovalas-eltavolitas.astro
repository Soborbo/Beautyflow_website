---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import LocationsSection from '../components/LocationsSection.astro';
import { ContentImage, CardImage, FixedImage } from '../components/images';

// Image imports
import notinoIkon from '../assets/images/notino-ikon.png';
import googleLogo from '../assets/images/google-logo.jpg';
import heroImage from '../assets/images/tetovalas-eltavolitas-budapest.jpg';
import konnyaFanniKonzultacio from '../assets/images/konya-fanni-konzultacio.webp';
import sminktetovalasEltavolitas from '../assets/images/sminktetovalas-eltavolitas.jpg';
import tetovalasEltavolitasAgy from '../assets/images/tetovalas-eltavolitas-agy.jpg';
import szemoldokTetovalasEltavolitas from '../assets/images/szemoldok-tetovalas-eltavolitas.jpg';
import egyediUtoapoloKrem from '../assets/images/egyedi-utoapolo-krem.jpg';
import secondSkinVedelem from '../assets/images/second-skin-vedelem.jpg';
import tetovalasEltavolitasBp from '../assets/images/tetovalas-eltavolitas-bp.jpg';
import hidegkalapacs from '../assets/images/hidegkalapacs.webp';
import keresztesiImage from '../assets/images/keresztesi.png';
import kittiImage from '../assets/images/kitti.png';
import doraImage from '../assets/images/dora.png';
import notinoLogoSm from '../assets/images/logok/notino-logo-sm.jpg';
import skinlabLogo from '../assets/images/logok/skinlab.webp';
import aiVezreltGepek from '../assets/images/ai-vezrelt-gepek.jpg';
import szegyenlosVendeg from '../assets/images/szegyenlos-vendeg.jpg';
import konnyaFanniSzepsegszalon from '../assets/images/konya-fanni-szepsegszalonja.jpg';
import higieniaImage from '../assets/images/higienia.jpg';
import testmeretImage from '../assets/images/testmeret.jpg';
import nyitvaImage from '../assets/images/nyitva.jpg';
import lezeresGep from '../assets/images/lezeres-gep.jpg';
import lezerBeallitas from '../assets/images/lezer-beallitas.jpg';

const notinoUrlBuda = "https://www.notino.hu/szalonok/beautyflow?source_caller=ui&shortlink=lbbsjxf8&c=salon_detail_redirect&pid=notino_partner&deep_link_value=https%3A%2F%2Fnotino.hu%2Fszalonok%2Fbeautyflow&af_xp=custom";
const notinoUrlPest = "https://www.notino.hu/szalonok/beautyflow-pest?source_caller=ui&shortlink=lbbsjxf8&c=salon_detail_redirect&pid=notino_partner&deep_link_value=https%3A%2F%2Fnotino.hu%2Fszalonok%2Fbeautyflow-pest&af_xp=custom";

const stats = [
  { value: '10+ év', label: 'tapasztalat' },
  { value: '2 000+', label: 'eltávolított tetoválás' },
  { value: '100%', label: 'elégedett vendég' },
  { value: '0', label: 'maradandó heg' },
];

const testimonials = [
  {
    text: '6 éve járok hozzá, kedves, pontos és nagyon igényes a munkájára. A "neves" sminktetoválók által elrontott szemöldöktetoválásomat is Fanni tette tökéletessé. Szívből ajánlom őt!',
    author: 'Keresztesi-Szabó Szilvia',
    image: keresztesiImage
  },
  {
    text: 'Fannihoz járok szőrtelenítésre, és nagyon elégedett vagyok Vele. Kedvességével, profizmusával, mindig hamar elrepül az ott töltött idő. Csak ajánlani tudom.',
    author: 'Keul Kitti',
    image: kittiImage
  },
  {
    text: 'Lézeres szőrtelenítésre járok hozzá és nagyon örülök, hogy őt választottam. Amit eddig kezelt nekem, az baromi látványos.. Figyelmes és a szalonja is tip-top.',
    author: 'Erdei Dóra',
    image: doraImage
  }
];

const arcPrices = [
  { area: 'Szemöldök', price: '20 000 Ft' },
  { area: 'Ajakkontúr', price: '15 000 Ft' },
  { area: 'Smink (részleges)', price: '15 000 Ft' },
];

const testPrices = [
  { size: '2x2 cm', price: '10 000 Ft' },
  { size: '5x5 cm', price: '20 000 Ft' },
  { size: '8x8 cm', price: '25 000 Ft' },
  { size: '10x10 cm (tenyérnyi)', price: '30 000 Ft-tól' },
];

const howItWorks = [
  {
    number: '1.',
    title: 'Ingyenes konzultáció',
    description: 'Felmérjük a tetoválásod méretét, színeit és állapotát. Elmondjuk, mire számíthatsz, hány kezelés kell, és válaszolunk minden kérdésedre.'
  },
  {
    number: '2.',
    title: 'Előkészítés és hűtés',
    description: 'A kezelendő területet alaposan megtisztítjuk és hidegkalapáccsal hűtjük. Ez minimalizálja a fájdalmat és csökkenti a duzzanatot.'
  },
  {
    number: '3.',
    title: 'Lézeres kezelés',
    description: 'A lézer precízen célozza meg a pigmenteket, rétegről rétegre bontva le őket. A kezelés időtartama a tetoválás méretétől függ.'
  },
  {
    number: '4.',
    title: 'Second Skin védelem',
    description: 'A kezelt területet steril Second Skin védelemmel látjuk el és egyedi utóápoló krémet adunk. A következő kezelés 6-8 hét múlva esedékes.'
  }
];

const faqs = [
  { question: 'Hány kezelés szükséges a tetoválás teljes eltávolításához?', answer: 'Általában 6-12 kezelésre van szükség, de ez függ a tetoválás méretétől, színeitől, korától és a felhasznált festék minőségétől. A sminktetoválások általában kevesebb kezeléssel eltávolíthatók.' },
  { question: 'Mennyire fájdalmas a lézeres tetoválás eltávolítás?', answer: 'Hidegkalapácsos hűtési technikánknak köszönhetően a kezelés érezhetően kevésbé fájdalmas, mint a hagyományos módszereknél. A legtöbb vendégünk enyhe csípést érez.' },
  { question: 'Marad-e heg a kezelés után?', answer: 'Egyedi frekvenciabeállításunknak köszönhetően mindig csak egy pigmentréteget célzunk, így nincs vérzés, seb vagy maradandó hegesedés. A bőr természetesen regenerálódik.' },
  { question: 'Milyen színű tetoválásokat lehet eltávolítani?', answer: 'A lézerünk hatékonyan kezeli a fekete, sötétkék, zöld és piros színeket. A világosabb színek (sárga, fehér, narancssárga) nehezebben távolíthatók el.' },
  { question: 'Mennyi idő telik el két kezelés között?', answer: 'A kezelések között 6-8 hetet kell várni, hogy a bőr teljesen regenerálódjon és a szervezet eltávolítsa a lebontott pigmentrészecskéket.' },
  { question: 'Lehet-e részlegesen eltávolítani vagy halványítani a tetoválást?', answer: 'Igen, ha cover-up tetoválást tervezel, elég lehet a tetoválás halványítása. Ezt kevesebb kezeléssel is el lehet érni.' },
  { question: 'Mit kell csinálni a kezelés előtt?', answer: 'Kerüld a napozást és az önbarnítót 2 hétig a kezelés előtt. A kezelt területen ne legyen sérülés vagy irritáció.' },
  { question: 'Hogyan kell ápolni a kezelt területet?', answer: 'A Second Skin védelmet 3-5 napig hagyd a helyén. Utána az általunk adott utóápoló krémmel kend naponta. Kerüld a napozást, uszodát, szaunát 2 hétig.' },
  { question: 'Sminktetoválást is el lehet távolítani?', answer: 'Igen, a szemöldök, szemhéj és ajak sminktetoválások is eltávolíthatók. Ezeknél általában kevesebb kezelés is elegendő.' },
  { question: 'Van-e kockázata a kezelésnek?', answer: 'A lézeres tetoválás eltávolítás biztonságos eljárás. Átmeneti bőrpír, enyhe duzzanat jelentkezhet, ami pár napon belül elmúlik.' },
];

---

<Layout
  title="Lézeres Tetoválás Eltávolítás Budapest - Hegmentes, Biztonságos | Beautyflow"
  description="Lézeres tetoválás eltávolítás Budapesten hegmentesen és biztonságosan. Hidegkalapácsos technika, Second Skin védelem, egyedi utóápoló krém. Kérj ingyenes konzultációt!"
  ogImage="/images/tetovalas-eltavolitas-budapest.jpg"
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Főoldal",
        "item": "https://beautyflow.pro/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Lézeres Tetoválás Eltávolítás",
        "item": "https://beautyflow.pro/lezeres-tetovalas-eltavolitas/"
      }
    ]
  })} />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Lézeres tetoválás eltávolítás",
    "name": "Lézeres Tetoválás Eltávolítás Budapest",
    "description": "Professzionális lézeres tetoválás eltávolítás Budapesten. Hegmentes, biztonságos kezelés modern technológiával.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Beautyflow Szépségszalon",
      "image": "https://beautyflow.pro/images/beautyflow-logo.png",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Vegyész u. 1.",
          "addressLocality": "Budapest",
          "postalCode": "1116",
          "addressCountry": "HU"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Reitter Ferenc u. 90.",
          "addressLocality": "Budapest",
          "postalCode": "1135",
          "addressCountry": "HU"
        }
      ],
      "telephone": "+36 1 300 9414",
      "priceRange": "$$"
    },
    "areaServed": {
      "@type": "City",
      "name": "Budapest"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Tetoválás eltávolítás árak",
      "itemListElement": [
        ...arcPrices.map(item => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": `Tetoválás eltávolítás (arc) - ${item.area}`
          },
          "price": item.price.replace(/[^0-9]/g, '') || "0",
          "priceCurrency": "HUF"
        })),
        ...testPrices.map(item => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": `Tetoválás eltávolítás (test) - ${item.size}`
          },
          "price": item.price.replace(/[^0-9]/g, '') || "0",
          "priceCurrency": "HUF"
        }))
      ]
    }
  })} />

  <!-- Hero Section -->
  <section class="hero-section relative lg:h-[calc(100dvh-60px)] flex flex-col">
    <div class="flex flex-col lg:flex-row flex-1 min-h-0">
      <!-- Left column: Text content -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center py-6 lg:py-8 order-2 lg:order-1 bg-[#fff9f7]">
        <div class="w-full px-[6%] text-center">
          <!-- Notino Award Badge -->
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full blur-sm opacity-50"></div>
              <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500 p-1 rounded-full">
                <div class="bg-white rounded-full p-1">
                  <FixedImage src={notinoIkon} alt="Notino" width={32} height={32} class="w-8 h-8" />
                </div>
              </div>
            </div>
            <div class="text-left">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Díjnyertes szalon</span>
              </div>
              <span class="text-sm font-bold text-[#c53f75]">Notino "Hónap Szalonja"</span>
            </div>
          </div>

          <h1 class="text-[#c53f75] font-semibold uppercase tracking-wider text-sm lg:text-base mb-2">
            Tetoválás eltávolítás Budapesten
          </h1>
          <h2 class="font-heading text-[1.75rem] lg:text-[2.25rem] text-gray-900 mb-3 uppercase leading-tight">
            Gyors, kíméletes és biztonságos lézeres tetoválás eltávolítás
          </h2>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-lg mx-auto">
            Nem kell tovább rejtegetned a megunt vagy elrontott tetoválásodat. Szalonjainkban a legmodernebb lézeres gépekkel és sokéves tapasztalattal várunk.
          </p>

          <!-- CTA row -->
          <div class="flex flex-col items-center justify-center gap-2">
            <a
              href="/ingyenes-konzultacio/"
              class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg text-sm lg:text-base"
            >
              Kérj Ingyenes konzultációt
            </a>
            <a
              href="tel:+3613009414"
              class="inline-flex items-center gap-2 text-base lg:text-lg text-[#c53f75] font-bold hover:text-[#a33460] transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +36 1 300 9414
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: Hero image -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2 relative overflow-hidden min-h-[300px] lg:min-h-0">
        <ContentImage
          src={heroImage}
          alt="Lézeres tetoválás eltávolítás Budapest"
          class="w-full h-full object-cover"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:hidden"></div>

        <!-- Google Rating Badge -->
        <div class="absolute bottom-3 left-3 lg:bottom-5 lg:left-5 bg-white/95 backdrop-blur-sm rounded-xl shadow-xl p-2 lg:p-3">
          <div class="flex items-center gap-2">
            <FixedImage src={googleLogo} alt="Google" width={36} height={36} class="w-7 h-7 lg:w-9 lg:h-9 rounded-full" />
            <div>
              <div class="flex items-center gap-1">
                <span class="text-base lg:text-xl font-bold text-gray-900 rating-number" data-target="5.0">0</span>
                <div class="flex">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-2.5 h-2.5 lg:w-3.5 lg:h-3.5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
              <p class="text-[9px] lg:text-[11px] text-gray-600">Google értékelés alapján</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="w-full bg-gradient-to-r from-[#c53f75] to-[#a33460] py-4 lg:h-[80px] flex-shrink-0 flex items-center justify-center">
      <div class="max-w-[1000px] mx-auto px-4 w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-8 h-full items-center">
          {stats.map((stat, index) => (
            <div class="text-center stat-item py-2 lg:py-0" style={`animation-delay: ${index * 100}ms`}>
              <p class="text-[24px] lg:text-[32px] font-heading text-white font-bold leading-[0.9] mb-1">
                {stat.value}
              </p>
              <p class="text-white/80 text-[12px] lg:text-[16px] leading-[0.9]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section with Fanni -->
  <section class="section-animate py-12 lg:py-16 bg-gradient-to-br from-[#fdf8f6] via-[#fff] to-[#f8f4f9]">
    <div class="max-w-[1100px] mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <!-- Image - full width on mobile, stretch to fill height on desktop -->
          <div class="w-full lg:w-2/5 flex-shrink-0 relative">
            <ContentImage
              src={konnyaFanniKonzultacio}
              alt="Kónya Fanni tetoválás eltávolítás szakértő"
              class="w-full h-auto lg:absolute lg:inset-0 lg:h-full object-cover object-top"
            />
            <div class="lg:hidden flex items-center gap-3 p-4 bg-gray-50 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold text-sm mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-xs mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
          <div class="w-full lg:w-3/5 p-6 lg:p-8 flex flex-col justify-center">
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              Egy rosszul sikerült, megunt vagy időközben értelmét vesztett tetoválás nagyon zavaró tud lenni. A bosszúságon túl akár megbánást, sőt, <strong>szégyent és undort is érezhetsz</strong>, amikor ránézel – de ezen tudunk segíteni!
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              A lézeres tetoválás eltávolítás biztonságos, szinte teljesen fájdalommentes, és ha szakértő végzi magas minőségű géppel, <strong>az eredmény is teljes lehet</strong>.
            </p>
            <p class="text-gray-700 mb-6 text-base leading-relaxed">
              <strong>Kezdd el a kezeléseket nálunk, és szabadulj meg a zavaró érzéstől, amit a tetoválásod jelent!</strong>
            </p>
            <div class="hidden lg:flex items-center gap-3 pt-4 border-t border-gray-200">
              <div class="w-12 h-12 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-sm mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 1: Legyen újra öröm -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
          src={sminktetovalasEltavolitas}
          alt="Legyen újra öröm tükörbe nézni"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">
            Legyen újra öröm tükörbe nézni
          </h2>
          <p class="text-gray-700 mb-4">
            A megunt, elrontott, nem kívánt tetoválás többé nem kell, hogy a mindennapjaid része legyen.
          </p>
          <p class="text-gray-700 mb-6">
            Modern, kíméletes és <strong>hegmentes tetoválás eltávolító kezeléseinkkel</strong> visszakaphatod tiszta bőrödet, fájdalom és maradandó nyomok nélkül.
          </p>
        </div>
      </div>
    </div>
