---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import LocationsSection from '../components/LocationsSection.astro';
import { ContentImage, CardImage, HeroImage, FixedImage } from '../components/images';

// Image imports
import greenSeaPeelHero from '../assets/images/green-sea-peel-new-hero.jpg';
import greenSeaPeelOldHero from '../assets/images/green-sea-peel-hero.jpg';
import greenSeaPeelFeature from '../assets/images/green-sea-peel-feature.jpg';
import greenSeaPeelHamlasztas from '../assets/images/green-sea-peel-hamlasztas.jpg';
import greenSeaPeelEgyAlkalom from '../assets/images/green-sea-peel-egy-alkalom.jpg';
import greenSeaPeelHatter from '../assets/images/originals/carbon-peeling-hatter.webp'; // PLACEHOLDER
import konyaFanniSzepsegszalon from '../assets/images/Konya-Fanni-szepsegszalon.jpg';
import konyaFanniSzepsegszalonja from '../assets/images/konya-fanni-szepsegszalonja.jpg';
import konyaFanniKonzultacio from '../assets/images/konya-fanni-konzultacio.webp';
import notinoIkon from '../assets/images/notino-ikon.png';
import googleLogo from '../assets/images/google-logo.jpg';
import higienia from '../assets/images/higienia.jpg';
import testmeret from '../assets/images/testmeret.jpg';
import nyitva from '../assets/images/nyitva.jpg';
import notinoLogoSm from '../assets/images/logok/notino-logo-sm.jpg';
import skinlab from '../assets/images/logok/skinlab.webp';
import hydrabeautyArckezelesBeautyflow from '../assets/images/hydrabeauty-arckezeles-beautyflow.jpg'; // PLACEHOLDER
import mestersegesIntelligencia from '../assets/images/mesterseges-intelligencia-szortelenito-gep.jpg';


const stats = [
  { value: '10+ év', label: 'tapasztalat' },
  { value: '75', label: 'perces kezelés' },
  { value: '100%', label: 'prémium alapanyag' },
  { value: '3', label: 'hámlasztási szint' },
];

const testimonials = [
  {
    text: 'A Green Sea Peel kezelés után a bőröm teljesen megújult. A pigmentfoltjaim halványabbak lettek, a bőröm pedig kisimult és ragyogó. Imádom az eredményt!',
    author: 'Zsófi',
  },
  {
    text: 'Évek óta küzdöttem az aknéhegekkel. Már az első kezelés után óriási különbséget láttam. A hegek összehúzódtak és a bőröm textúrája látványosan javult.',
    author: 'Réka',
  },
  {
    text: 'Eleinte féltem a hámlástól, de megérte! A bőröm olyan lett, mintha kicserélték volna. Kónya Fanni mindent részletesen elmagyarázott és végig biztonságban éreztem magam.',
    author: 'Kata',
  }
];

const singlePrices = [
  { area: 'Green Sea Peel – Light', price: '30 000 Ft', description: 'Enyhe hámlasztás, púderszerű hámlás' },
  { area: 'Green Sea Peel – Medium', price: '30 000 Ft', description: 'Közepes hámlasztás' },
  { area: 'Green Sea Peel – Deep', price: '30 000 Ft', description: 'Intenzív, lemezes hámlás' },
];

const packages = [
  { area: '4 alkalmas kúra (Light)', originalPrice: '120 000', price: '96 000 Ft', discount: '-20%' },
  { area: '4 alkalmas kúra (Medium)', originalPrice: '120 000', price: '96 000 Ft', discount: '-20%' },
  { area: '4 alkalmas kúra (Deep)', originalPrice: '120 000', price: '96 000 Ft', discount: '-20%' },
];

const howItWorks = [
  {
    number: '1.',
    title: 'Bőranalízis és tisztítás',
    description: 'Lemossuk és tónizáljuk a bőröd, majd felmérjük az állapotát. Megbeszéljük, melyik hámlasztási szint (light, medium vagy deep) a legmegfelelőbb számodra.'
  },
  {
    number: '2.',
    title: 'Green Sea Peel felvitele',
    description: 'Felvisszük a koreai Green Sea Peel keveréket és 7-10 percen keresztül bemasszírozzuk a bőrbe. A tengeri szivacs mikrotűi mikrocsatornákat nyitnak, beindítva a sejtregenerációt.'
  },
  {
    number: '3.',
    title: 'Visszanyugtatás és maszk',
    description: 'Cicaplasztos fátyolmaszkkal és szenzitív termékekkel nyugtatjuk vissza a bőrt. LED fényterápiát is alkalmazunk a gyógyulás felgyorsítása érdekében.'
  },
  {
    number: '4.',
    title: 'Lezárás és utóápolás',
    description: 'Fényvédővel zárjuk a kezelést, és részletesen átbeszéljük az otthoni utóápolást. A hámlás 3-4 nap után indul és kb. egy hétig tart – alatta a bőröd teljesen megújul.'
  }
];

const faqs = [
  { question: 'Mennyire fájdalmas a Green Sea Peel kezelés?', answer: 'A kezelés kellemetlen érzéssel jár – sokan az üvegszilánkokkal való radírozáshoz hasonlítják. A tengeri szivacs mikrotűi okozzák ezt az érzést a bemasszírozás során, de a kezelés összesen csak 7-10 percig tart.' },
  { question: 'Kinek ajánlott a Green Sea Peel?', answer: 'Pigmentfoltos, heges (aknéheg, bárányhimlőheg), zsíros, tágpórusú bőrre, valamint anti-aging kezelésként is kiváló. Kortól függetlenül végezhető.' },
  { question: 'Kinek NEM ajánlott a kezelés?', answer: 'Rozáciás, nagyon érzékeny, aktív aknés bőrre, herpesz esetén, illetve rák/kagyló/alga allergia esetén nem végezhető. Anyajegyeket ki kell kerülni, túl anyajegyes bőr esetén nem javasolt.' },
  { question: 'Hány kezelés szükséges?', answer: 'Már egy kezelés után is komplett bőrmegújulás tapasztalható. Hegek kezelésére 4 alkalmas kúra javasolt, 28 naponként. Utána évente 1 fenntartó kezelés elegendő.' },
  { question: 'Milyen a hámlás?', answer: 'A hámlás 3-4 nap után indul és kb. egy hétig tart. Light kezelésnél púderszerű, medium esetén közepes, deep kezelésnél lemezes hámlás várható – nagy bőrdarabokban jön le a régi bőr, alatta friss, megújult bőr jelenik meg.' },
  { question: 'Mit kell tennem a kezelés után?', answer: 'Csak langyos víz és fényvédő használata megengedett. Tilos a hidratáló, lemosó, retinol és bármilyen ápoló termék használata a hámlás ideje alatt. A bőr öngyógyító mechanizmusára kell bízni a folyamatot.' },
  { question: 'Mikor végezhető a kezelés?', answer: 'Kizárólag a téli hónapokban, novembertől májusig. Nyáron a fokozott UV-sugárzás miatt nem végezhető.' },
  { question: 'Van-e leállási idő?', answer: 'Igen, a kezelés után 3-7 napig hámlás várható, ami során pirosság is jelentkezik. Ez idő alatt nem ajánlott fontos események előtt elvégeztetni.' },
  { question: 'Kombinálható más kezelésekkel?', answer: 'A Green Sea Peel önmagában egy komplex kezelés. Nálunk LED fényterápiával is kiegészítjük az árban benne foglaltan. Más kezeléssel nem kombinálható egyidejűleg.' },
  { question: 'Mit tartalmaz a kezelés ára?', answer: '75 perces kezelést kapsz, prémium koreai és német termékekkel, LED fényterápiával kiegészítve. A bőrt a kezelés végén gondosan visszanyugtatjuk szenzitív termékekkel.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title="Green Sea Peel Kezelés Budapest - Tengeri Szivacstűs Hámlasztás | Beautyflow"
  description="Prémium Green Sea Peel kezelés Budapesten. Koreai tengeri szivacstűs bőrmegújítás pigmentfoltokra, aknéhegekre és ráncokra. 75 perces luxus program LED fényterápiával. Kérj ingyenes konzultációt!"
  ogImage="/images/hydrabeauty-arckezeles.jpg"
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Főoldal",
        "item": "https://beautyflow.pro/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Green Sea Peel Kezelés",
        "item": "https://beautyflow.pro/green-sea-peel/"
      }
    ]
  })} />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Green Sea Peel",
    "name": "Green Sea Peel Kezelés Budapest",
    "description": "Prémium Green Sea Peel kezelés Budapesten. Koreai tengeri szivacstűs bőrmegújítás pigmentfoltokra, aknéhegekre és ráncokra.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Beautyflow Szépségszalon",
      "image": "https://beautyflow.pro/images/beautyflow-logo.png",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Vegyész u. 1.",
          "addressLocality": "Budapest",
          "postalCode": "1116",
          "addressCountry": "HU"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Reitter Ferenc u. 90.",
          "addressLocality": "Budapest",
          "postalCode": "1135",
          "addressCountry": "HU"
        }
      ],
      "telephone": "+36 1 300 9414",
      "priceRange": "$$$"
    },
    "areaServed": {
      "@type": "City",
      "name": "Budapest"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Green Sea Peel szolgáltatások",
      "itemListElement": singlePrices.map(item => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": item.area
        },
        "price": item.price.replace(/[^0-9]/g, ''),
        "priceCurrency": "HUF"
      }))
    }
  })} />

  <!-- Hero Section -->
  <section class="hero-section relative lg:h-[calc(100dvh-60px)] flex flex-col">
    <div class="flex flex-col lg:flex-row flex-1 min-h-0">
      <!-- Left column: Text content -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center py-6 lg:py-8 order-2 lg:order-1 bg-[#fff9f7]">
        <div class="w-full px-[6%] text-center">
          <!-- Notino Award Badge -->
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full blur-sm opacity-50"></div>
              <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500 p-1 rounded-full">
                <div class="bg-white rounded-full p-1">
                  <FixedImage src={notinoIkon} alt="Notino" width={32} height={32} class="w-8 h-8" />
                </div>
              </div>
            </div>
            <div class="text-left">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Díjnyertes szalon</span>
              </div>
              <span class="text-sm font-bold text-[#c53f75]">Notino "Hónap Szalonja"</span>
            </div>
          </div>

          <h1 class="text-[#c53f75] font-semibold uppercase tracking-wider text-sm lg:text-base mb-2">
            Green Sea Peel kezelés Budapesten
          </h1>
          <h2 class="font-heading text-[1.75rem] lg:text-[2.25rem] text-gray-900 mb-3 uppercase leading-tight">
            Kapj teljesen új bőrt
          </h2>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-lg mx-auto">
            A régi, sérült bőröd leválik, alatta pedig friss, ragyogó bőr jelenik meg. Hatékony kezelés pigmentfoltokra, aknéhegekre és ráncokra is.
          </p>

          <!-- CTA row -->
          <div class="flex flex-col items-center justify-center gap-2">
            <a
              href="/ingyenes-konzultacio/"
              class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-lg hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg text-sm lg:text-base"
            >
              Kérj Ingyenes konzultációt
            </a>
            <a
              href="tel:+3613009414"
              class="inline-flex items-center gap-2 text-base lg:text-lg text-[#c53f75] font-bold hover:text-[#a33460] transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +36 1 300 9414
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: Hero image -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2 relative overflow-hidden min-h-[300px] lg:min-h-0">
        <ContentImage
          src={greenSeaPeelHero}
          alt="Green Sea Peel kezelés Budapest"
          class="w-full h-full object-cover"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:hidden"></div>

        <!-- Google Rating Badge -->
        <div class="absolute bottom-3 left-3 lg:bottom-5 lg:left-5 bg-white/95 backdrop-blur-sm rounded-xl shadow-xl p-2 lg:p-3">
          <div class="flex items-center gap-2">
            <FixedImage src={googleLogo} alt="Google" width={36} height={36} class="w-7 h-7 lg:w-9 lg:h-9 rounded-full" />
            <div>
              <div class="flex items-center gap-1">
                <span class="text-base lg:text-xl font-bold text-gray-900 rating-number" data-target="5.0">0</span>
                <div class="flex">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-2.5 h-2.5 lg:w-3.5 lg:h-3.5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
              <p class="text-[9px] lg:text-[11px] text-gray-600">Google értékelés alapján</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="w-full bg-gradient-to-r from-[#c53f75] to-[#a33460] py-4 lg:h-[80px] flex-shrink-0 flex items-center justify-center">
      <div class="max-w-[1000px] mx-auto px-4 w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-8 h-full items-center">
          {stats.map((stat, index) => (
            <div class="text-center stat-item py-2 lg:py-0" style={`animation-delay: ${index * 100}ms`}>
              <p class="text-[24px] lg:text-[32px] font-heading text-white font-bold leading-[0.9] mb-1">
                {stat.value}
              </p>
              <p class="text-white/80 text-[12px] lg:text-[16px] leading-[0.9]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section with Fanni -->
  <section class="section-animate py-12 lg:py-16 bg-gradient-to-br from-[#fdf8f6] via-[#fff] to-[#f8f4f9]">
    <div class="max-w-[1100px] mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <!-- Image -->
          <div class="w-full lg:w-2/5 flex-shrink-0 relative">
            <ContentImage
              src={konyaFanniSzepsegszalon}
              alt="Kónya Fanni Green Sea Peel szakértő"
              class="w-full h-auto lg:absolute lg:inset-0 lg:h-full object-cover object-top"
            />
            <!-- Mobile signature -->
            <div class="lg:hidden flex items-center gap-3 p-4 bg-gray-50 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold text-sm mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-xs mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
          <!-- Text content -->
          <div class="w-full lg:w-3/5 p-6 lg:p-8 flex flex-col justify-center">
            <p class="text-gray-700 mb-5 leading-relaxed" style="font-size: 18px;">
              Hiába használod naponta a legjobb krémeket, a pigmentfoltok, az aknéhegek és a fakó bőr nem akar eltűnni? Ez azért van, mert ezek a problémák a bőr mélyebb rétegeiben vannak – és oda a hagyományos ápolás nem jut le.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              A Green Sea Peel egy prémium koreai hámlasztó kezelés, amelyben <strong>tengeri szivacs mikrotűk hatolnak le a bőr mélyébe</strong> és beindítják a természetes sejtregenerációt. Két márkát is kipróbáltam, mielőtt döntöttem: Korea a kozmetikai ipar éllovasa, ezért a KRX Aesthetics mellett döntöttem – ötször annyiba is kerül, mint az olcsóbb alternatívák, de az eredmény nem is hasonlítható össze.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              Saját magamon próbáltam ki először. Már a kezelés közben éreztem, ahogy <strong>a véráram beindult, a sejtregeneráció azonnal elkezdődött</strong>, és utána rettenetes szomjas voltam – a nyirokkeringést is beindította. A kezelés után a régi, sérült bőr lemezes hámlással leválik, és alatta <strong>friss, megújult, pigmentfolt-mentes bőr jelenik meg</strong>. Olyan, mintha teljesen új bőrt kapnál.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              Ez a kezelés nem arctisztító eljárás, mint a Hydratouch, és nem is enyhe hámlasztás, mint a Carbon Peeling. <strong>Ez egy intenzív, mélyrétegi bőrmegújító kezelés</strong>, amely csodákra képes heges, pigmentfoltos és öregedő bőrön egyaránt. A 11. és 13. kerületben két szalonunkkal is elérhető vagyunk.
            </p>
            <p class="text-gray-700 mb-6 text-base leading-relaxed">
              <strong>Ha eleged van a pigmentfoltokból, az aknéhegekből, vagy egyszerűen szeretnéd, hogy a bőröd újra fiatalos és ragyogó legyen – a Green Sea Peel a leghatékonyabb megoldás, amit kipróbálhatsz.</strong>
            </p>
            <!-- Desktop signature -->
            <div class="hidden lg:flex items-center gap-3 pt-4 border-t border-gray-200">
              <div class="w-12 h-12 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-sm mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 1: Bőrmegújulás - Image left, Text right -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
          src={greenSeaPeelFeature}
          alt="Green Sea Peel bőrmegújítás"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">
            Komplett bőrmegújulás egyetlen kezeléssel
