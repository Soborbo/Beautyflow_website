<Layout
  title="Árak - Beautyflow Szépségszalon Budapest"
  description="A Beautyflow szépségszalon árlistája: lézeres szőrtelenítés, kozmetikai kezelések, plazmaterápia, carbon peeling, tetoválás- és pigmentfolt-eltávolítás árai Budapesten."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#f0ebe8] to-[#e8e0dc] py-8 lg:py-12">
    <div class="container mx-auto px-4 text-center">
      <h1 class="font-heading text-3xl lg:text-5xl text-gray-900 mb-3">
        Áraink
      </h1>
      <p class="text-gray-600 max-w-2xl mx-auto text-sm lg:text-base">
        Átlátható árazás, minőségi szolgáltatások. Válassz a kezelések közül és foglalj időpontot online!
      </p>
      <p class="text-gray-500 text-xs lg:text-sm mt-3">
        Érvényes: {priceListValidFrom} napjától
      </p>
    </div>
  </section>

  <!-- VIP Loyalty Banner -->
  <section class="bg-gradient-to-r from-[#c53f75] to-[#a33460] py-5">
    <div class="container mx-auto px-4 text-center">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <div class="flex items-center gap-2">
          <span class="text-2xl">&#11088;</span>
          <span class="text-white font-heading text-lg sm:text-xl font-bold uppercase">Törzsvásárlói VIP Program</span>
        </div>
        <span class="hidden sm:block w-px h-6 bg-white/30"></span>
        <p class="text-white/90 text-sm sm:text-base">
          Gyűjts pecsétet minden kezelés után! <strong class="text-white">15 pecsét = örökös 10% kedvezmény</strong> minden kezelésre.
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky Navigation -->
  <nav id="price-nav" class="sticky top-[60px] z-40 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
    <div class="container mx-auto px-4">
      <div class="flex gap-1 overflow-x-auto py-3 scrollbar-hide">
        {categories.map((cat, index) => (
          <button
            class={`price-nav-btn whitespace-nowrap px-4 py-2 text-sm font-medium rounded-full transition-all ${index === 0 ? 'active' : ''}`}
            data-target={cat.id}
            data-color={cat.color.primary}
            style={index === 0 ? `background-color: ${cat.color.primary}; color: white;` : ''}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </nav>

  <main class="py-8 lg:py-12 bg-gray-50">
    <div class="container mx-auto px-4 max-w-5xl">

      <!-- Lézeres Szőrtelenítés Csomagok -->
      <section id="lezeres-csomagok" class="price-section mb-12 p-6 rounded-2xl" style={`background-color: ${categoryColors['lezeres'].bg};`}>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-8 rounded-full" style={`background-color: ${categoryColors['lezeres'].primary};`}></div>
          <h2 class="font-heading text-2xl lg:text-3xl text-gray-900">Lézeres szőrtelenítés csomagok</h2>
        </div>

        <!-- Ingyenes konzultáció -->
        <div class="bg-white rounded-lg p-5 shadow-sm border-2 border-dashed border-blue-300 mb-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <h3 class="font-semibold text-lg text-gray-900 mb-1">{ingyenesKonzultacio.name}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{ingyenesKonzultacio.zones}</p>
            </div>
            <div class="text-right whitespace-nowrap">
              <span class="text-2xl font-bold text-blue-600">{ingyenesKonzultacio.price}</span>
              <span class="block text-gray-500 text-sm">{ingyenesKonzultacio.duration}</span>
            </div>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {lezerCsomagok.map((csomag) => (
            <div class={`bg-white rounded-lg p-5 shadow-sm border ${csomag.popular ? 'border-blue-300 ring-2 ring-blue-100' : 'border-gray-200'} relative flex flex-col`}>
              {csomag.popular && (
                <span class="absolute -top-3 left-4 bg-blue-500 text-white text-xs font-semibold px-3 py-1 rounded-full">
                  Legnépszerűbb
                </span>
              )}
              <h3 class="font-semibold text-lg text-gray-900 mb-2">{csomag.name} csomag</h3>
              <p class="text-gray-600 text-sm mb-4 leading-relaxed flex-grow">{csomag.zones}</p>
              <div class="flex items-baseline justify-between">
                <span class="text-2xl font-bold text-gray-900 whitespace-nowrap">{csomag.price}</span>
                <span class="text-gray-500 text-sm">{csomag.duration}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Diamond foglaló -->
        <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
          <p class="text-sm text-gray-800">
            <strong>Diamond csomag esetén minden időpont előtt foglaló szükséges!</strong>
            Részletek a <a href="/hazirend" class="text-blue-600 underline hover:text-blue-700">házirendben</a>.
          </p>
        </div>

        <!-- Csomagbérletek -->
        <h3 class="font-semibold text-lg text-gray-800 mt-8 mb-3">Csomagbérletek</h3>
        <div class="grid grid-cols-3 gap-3">
          {csomagBerletek.map((berlet) => (
            <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-200 text-center">
              <span class="block text-sm text-gray-600 mb-2">{berlet.alkalom}</span>
              <span class="inline-block bg-blue-100 text-blue-700 font-bold px-3 py-1 rounded-full">{berlet.discount}</span>
            </div>
          ))}
        </div>

        <div class="mt-6 text-center">
          <a href={notinoUrl} target="_blank" rel="noopener" class="cta-btn inline-block text-white font-semibold px-8 py-3 rounded-full transition-all" style={`background-color: ${categoryColors['lezeres'].primary};`}>
            Időpontfoglalás
          </a>
        </div>
      </section>

      <!-- Diódalézeres szőrtelenítés – területenként -->
      <section id="lezeres-berletek" class="price-section mb-12 p-6 rounded-2xl" style={`background-color: ${categoryColors['lezeres'].bg};`}>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-8 rounded-full" style={`background-color: ${categoryColors['lezeres'].primary};`}></div>
          <h2 class="font-heading text-2xl lg:text-3xl text-gray-900">Diódalézeres szőrtelenítés bérletek</h2>
        </div>

        <p class="text-gray-600 text-sm mb-4">Bérletekkel akár 20% kedvezményt kaphatsz! Minél több alkalmat választasz, annál többet spórolsz.</p>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-blue-50">
                <tr>
                  <th class="text-left py-3 px-4 font-semibold text-gray-700">Terület</th>
                  <th class="text-center py-3 px-3 font-semibold text-gray-700">1 alk.</th>
                  <th class="text-center py-3 px-3 font-semibold text-gray-700">
                    <div class="flex flex-col items-center gap-1">
                      <span>3 alk.</span>
                      <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">-10%</span>
                    </div>
                  </th>
                  <th class="text-center py-3 px-3 font-semibold text-gray-700">
                    <div class="flex flex-col items-center gap-1">
                      <span>6 alk.</span>
                      <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">-15%</span>
                    </div>
                  </th>
                  <th class="text-center py-3 px-3 font-semibold text-gray-700">
                    <div class="flex flex-col items-center gap-1">
                      <span>10 alk.</span>
                      <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">-20%</span>
                    </div>
                  </th>
                </tr>
              </thead>
              <tbody>
                {lezerBerletekGrouped.map((group, groupIndex) => (
                  <>
                    {/* Group header row */}
                    <tr class={`bg-blue-100/50 ${groupIndex > 0 ? 'border-t-2 border-blue-200' : ''}`}>
                      <td colspan="5" class="py-2 px-4 font-semibold text-blue-800 text-xs uppercase tracking-wider">
                        {group.group}
                      </td>
                    </tr>
                    {/* Items in group */}
                    {group.items.map((item) => (
                      <tr class="hover:bg-gray-50 border-b border-gray-100">
                        <td class="py-3 px-4 font-medium text-gray-900 whitespace-nowrap">{item.zone}</td>
                        <td class="py-3 px-3 text-center text-gray-700 whitespace-nowrap">{item.prices[0]} Ft</td>
                        <td class="py-3 px-3 text-center text-gray-700 whitespace-nowrap">{item.prices[1]} Ft</td>
                        <td class="py-3 px-3 text-center text-gray-700 whitespace-nowrap">{item.prices[2]} Ft</td>
                        <td class="py-3 px-3 text-center text-blue-600 font-semibold whitespace-nowrap">{item.prices[3]} Ft</td>
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-6 text-center">
          <a href={notinoUrl} target="_blank" rel="noopener" class="cta-btn inline-block text-white font-semibold px-8 py-3 rounded-full transition-all" style={`background-color: ${categoryColors['lezeres'].primary};`}>
            Időpontfoglalás
          </a>
        </div>
      </section>

      <!-- Kozmetikai és lézeres kezelések -->
      {treatmentSections.map((section) => (
        <section id={section.id} class="price-section mb-12 p-6 rounded-2xl" style={`background-color: ${section.color.bg};`}>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1 h-8 rounded-full" style={`background-color: ${section.color.primary};`}></div>
            <h2 class="font-heading text-2xl lg:text-3xl text-gray-900">{section.label}</h2>
          </div>

          {section.highlight && (
            <div class="mb-6 p-4 bg-white rounded-lg border-l-4" style={`border-color: ${section.color.primary};`}>
              <p class="text-sm font-semibold text-gray-800">{section.highlight}</p>
            </div>
          )}

          <div class="space-y-8">
            {section.groups.map((group) => (
              <div>
                {group.title && (
                  <h3 class="font-semibold text-lg text-gray-800 mb-2">{group.title}</h3>
                )}
                {group.note && (
                  <p class="text-gray-600 text-sm mb-3">{group.note}</p>
                )}
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                  <table class="w-full text-sm">
                    <tbody class="divide-y divide-gray-100">
                      {group.items.map((item) => (
                        <tr class="hover:bg-gray-50 align-top">
                          <td class="py-4 px-5">
                            <span class="font-medium text-gray-900">{item.name}</span>
                            {item.desc && (
                              <span class="block text-xs text-gray-500 mt-1 leading-relaxed">{item.desc}</span>
                            )}
                          </td>
                          <td class="py-4 px-5 text-right whitespace-nowrap">
                            <span class="text-lg font-bold text-gray-900">{item.price}</span>
                            {item.duration && (
                              <span class="block text-xs text-gray-500 mt-1">{item.duration}</span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {group.footnote && (
                  <p class="mt-3 text-sm text-gray-600 italic">{group.footnote}</p>
                )}
              </div>
            ))}
          </div>

          <div class="mt-6 text-center">
            <a
              href={section.ctaHref ?? notinoUrl}
              target={section.ctaHref ? undefined : '_blank'}
              rel={section.ctaHref ? undefined : 'noopener'}
              class="cta-btn inline-block text-white font-semibold px-8 py-3 rounded-full transition-all"
              style={`background-color: ${section.color.primary};`}
            >
              {section.ctaLabel ?? 'Időpontfoglalás'}
            </a>
          </div>
        </section>
      ))}

      <!-- CTA Section -->
      <section class="bg-gradient-to-r from-[#c53f75] to-[#a33460] rounded-lg p-8 text-center text-white">
        <h2 class="font-heading text-2xl lg:text-3xl mb-3">Kérdésed van az árakkal kapcsolatban?</h2>
        <p class="mb-6 opacity-90">Hívj minket vagy kérj ingyenes konzultációt és segítünk megtalálni a számodra ideális kezelést!</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+3613009414" class="inline-flex items-center justify-center gap-2 bg-white text-[#c53f75] font-semibold px-6 py-3 rounded-full hover:bg-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +36 1 300 9414
          </a>
          <a href="/ingyenes-konzultacio" class="inline-flex items-center justify-center gap-2 bg-white/20 text-white font-semibold px-6 py-3 rounded-full hover:bg-white/30 transition-colors border border-white/30">
            Ingyenes konzultáció
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .price-nav-btn {
    color: #4b5563;
    background-color: #f3f4f6;
  }

  .price-nav-btn:hover:not(.active) {
    background-color: #e5e7eb;
  }

  .price-nav-btn.active {
    color: white;
  }

  .cta-btn:hover {
    filter: brightness(0.92);
  }

  /* Smooth scroll offset for sticky nav */
  .price-section {
    scroll-margin-top: 140px;
  }
</style>

<script>
  function initPriceNav() {
    const navBtns = document.querySelectorAll<HTMLElement>('.price-nav-btn');
    const sections = document.querySelectorAll('.price-section');

    // Click handler for nav buttons
    navBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetSection = targetId ? document.getElementById(targetId) : null;
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Scroll spy - highlight active section in nav
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navBtns.forEach(btn => {
            const isActive = btn.getAttribute('data-target') === id;
            const color = btn.getAttribute('data-color');

            if (isActive) {
              btn.classList.add('active');
              btn.style.backgroundColor = color || '';
              btn.style.color = 'white';
            } else {
              btn.classList.remove('active');
              btn.style.backgroundColor = '';
              btn.style.color = '';
            }
          });
        }
      });
    }, {
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0
    });

    sections.forEach(section => observer.observe(section));
  }

  document.addEventListener('DOMContentLoaded', initPriceNav);
  document.addEventListener('astro:page-load', initPriceNav);
</script>
