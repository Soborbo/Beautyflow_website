---
/**
 * /bordiagnosztika — a bőrdiagnosztika szolgáltatás landing oldala.
 *
 * Ez a funnel kereskedelmi belépője: ide fut a hirdetési és az organikus
 * forgalom, innen ágazik el a meleg (időpontfoglalás) és a hideg (ingyenes
 * online bőranalízis kvíz → /boranalizis) látogató.
 *
 * Szótár — mindenhol következetesen:
 *   „ingyenes bőranalízis" = az online kvíz (0 Ft, /boranalizis)
 *   „bőrdiagnosztika"      = ez a szalonszolgáltatás (60 perc, 10 000 Ft)
 *
 * A 10 000 Ft-ot LEVONJUK az első kezelés árából — ez a landing legerősebb
 * kockázat-megfordítása, ezért szó szerint ugyanígy szerepel a 16 bőrtípus-
 * oldalon, az eredményoldalon és a kvíz vendég-emailjében is.
 *
 * Helyszín: MINDKÉT szalon (Buda és Pest) — a készülék mindkettőben elérhető.
 */
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import { HeroImage, ContentImage, CardImage } from '../components/images';

import heroImg from '../assets/images/bordiagnosztika/bordiagnosztika-konzultacio-beautyflow.jpg';
import gepImg from '../assets/images/bordiagnosztika/skitenic-ai-boranalizis-keszulek.jpg';
import kepernyoImg from '../assets/images/bordiagnosztika/ai-borelemzes-eredmeny-kepernyo.jpg';
import szkennelesImg from '../assets/images/bordiagnosztika/bordiagnosztika-arcszkenneles.jpg';
import kiertekelesImg from '../assets/images/bordiagnosztika/bordiagnosztika-kiertekeles.jpg';
import termekAtadasImg from '../assets/images/bordiagnosztika/otthoni-arcapolas-atadas.jpg';
import krxTermekekImg from '../assets/images/bordiagnosztika/krx-koreai-termekcsalad.jpg';
import krxTermekek2Img from '../assets/images/bordiagnosztika/krx-termekek-beautyflow.jpg';

const url = 'https://beautyflow.pro/bordiagnosztika';
const PRICE = 10000;
const DURATION_MIN = 60;

// A konzultációs űrlap előre kiválasztott kezeléssel — a lead nálunk landol
// (Sheets + CRM + szalon-email), nem egy külső foglalómotorban.
const CTA_HREF = '/ingyenes-konzultacio?kezeles=bordiagnosztika';

// A bőrdiagnosztika MINDKÉT szalonban elérhető — a vendég a hozzá közelebbit
// választja. A Notino-linkek a Headerben használt paraméterezést követik.
const SALONS = [
  {
    id: 'buda',
    name: 'Beautyflow Buda',
    address: '1116 Budapest, Vegyész utca 1. (XI. kerület)',
    page: '/beautyflow-buda',
    notino:
      'https://www.notino.hu/szalonok/beautyflow?source_caller=ui&shortlink=lbbsjxf8&c=salon_detail_redirect&pid=notino_partner&deep_link_value=https%3A%2F%2Fnotino.hu%2Fszalonok%2Fbeautyflow&af_xp=custom',
  },
  {
    id: 'pest',
    name: 'Beautyflow Pest',
    address: '1135 Budapest, Reitter Ferenc utca 90. (XIII. kerület)',
    page: '/beautyflow-pest',
    notino:
      'https://www.notino.hu/szalonok/beautyflow-pest?source_caller=ui&shortlink=lbbsjxf8&c=salon_detail_redirect&pid=notino_partner&deep_link_value=https%3A%2F%2Fnotino.hu%2Fszalonok%2Fbeautyflow-pest&af_xp=custom',
  },
];

// TODO(skinlab): amint a Skitenic terméklap élesedik a skinlabhungary.hu-n,
// cseréld a pontos termék-URL-re:
// /anti-aging/skitenic-ai-mesterseges-intelligencia-boranalizis-keszulek-821
// (2026-08-17-én még 404 — addig a kategóriaoldalra megyünk, ami él).
const SKINLAB_URL = 'https://skinlabhungary.hu/anti-aging/';

// A készülék által mért szempontok — a szalonban készült felvételen látható
// elemzési fülek alapján. Csak azt soroljuk fel, amit a gép ténylegesen mér.
const analysisPoints = [
  { title: 'Faggyútermelés', desc: 'Hol fénylik és hol szárad ki a bőröd — zónánként, nem ránézésre.' },
  { title: 'Hidratáltság', desc: 'A vízhiányos bőr nem ugyanaz, mint a száraz — ez a kettő szétválik.' },
  { title: 'Pórusok', desc: 'Méret és eltömődöttség a T-zónában és az arcél mentén.' },
  { title: 'Pigmentfoltok', desc: 'A felszín alatt lapuló foltok is, amiket szabad szemmel még nem látsz.' },
  { title: 'Ráncok', desc: 'Finom vonalak és mimikai ráncok térképe, mélység szerint.' },
  { title: 'Aknéra hajlamos területek', desc: 'A gyulladásra hajlamos zónák, még a kiütés megjelenése előtt.' },
  { title: 'Bőrtónus egyenletessége', desc: 'Pirosság, elszíneződés, egyenetlen tónus mértéke.' },
  { title: 'Érzékenység', desc: 'Mennyire reaktív a bőröd — ez dönti el, milyen erős hatóanyag fér bele.' },
];

const kinekAjanljuk = [
  'Ha még sosem jártál nálunk, és nem tudod, honnan induljon a bőrápolásod.',
  'Ha sok terméket végigpróbáltál már, de nem látsz eredményt.',
  'Ha visszatérő problémáid vannak — pattanás, pirosság, pigmentfolt —, és tudni szeretnéd, mi áll a hátterében.',
  'Ha hatásos, személyre szabott bőrápolási tervet szeretnél, nem csak egy alkalmi kezelést.',
  'Ha meg szeretnéd előzni a ráncokat, és egészséges bőrképet szeretnél minden nap.',
];

const folyamat = [
  { n: '1', title: 'Beszélgetés', desc: 'Elmondod, mi a problémád a bőröddel, és mik a céljaid. Ez adja a keretet mindennek, ami utána jön.' },
  { n: '2', title: 'Gépi arcszkennelés', desc: 'A készülék több megvilágításban rögzíti az arcodat, és kielemzi a bőr állapotát — a felszín alatti rétegeket is.' },
  { n: '3', title: 'Kiértékelés', desc: 'Együtt végignézzük a képernyőn, mit látunk. Egyszerű, érthető nyelven — nem ijesztgetünk szakzsargonnal.' },
  { n: '4', title: 'Kezelési terv', desc: 'Összeállítjuk a bőrödhöz illő kezeléssorozatot: mivel kezdünk, mi jön utána, és milyen ütemezésben.' },
  { n: '5', title: 'Otthoni rutin', desc: 'Kapsz egy személyre szabott otthoni ápolási javaslatot a KRX koreai prémium termékcsaládból, amit helyben meg is vásárolhatsz.' },
  { n: '6', title: 'Nyomon követés', desc: 'Minden további kezelésnél figyeljük a bőröd állapotát, és ha kell, finomítunk a terven.' },
];

const krxKategoriak = [
  {
    title: 'Tisztítás',
    desc: 'A rutin alapja: olyan lemosó és hámlasztó, ami a te bőröd faggyútermeléséhez van mérve — nem szárítja ki, és nem hagyja eltömődve.',
  },
  {
    title: 'Hidratálás',
    desc: 'Nyugtató, barrier-erősítő szérumok és krémek. Külön kezeljük a vízhiányos és a valóban száraz bőrt — más a megoldás a kettőre.',
  },
  {
    title: 'Pattanás & folt elleni',
    desc: 'Célzott hatóanyagok a gyulladásra hajlamos zónákra és az utánuk maradó elszíneződésekre, a bőröd tűrőképességéhez igazítva.',
  },
];

const faq = [
  {
    q: 'Mennyibe kerül a bőrdiagnosztika?',
    a: '10 000 Ft, és 60 percet vesz igénybe. A teljes összeget levonjuk az első kezelésed árából, így ha nálunk folytatod, gyakorlatilag ingyen van.',
  },
  {
    q: 'Fáj vagy kellemetlen a vizsgálat?',
    a: 'Egyáltalán nem. A gépi arcszkennelés érintés nélküli: néhány másodpercig ülsz a készülék előtt, miközben több megvilágításban fotó készül az arcodról. Semmilyen beavatkozás nem történik.',
  },
  {
    q: 'Melyik szalonban érhető el?',
    a: 'Mindkét szalonunkban: Beautyflow Buda (1116 Budapest, Vegyész utca 1.) és Beautyflow Pest (1135 Budapest, Reitter Ferenc utca 90.). Foglaláskor válaszd ki, melyik esik közelebb hozzád.',
  },
  {
    q: 'Sminkben mehetek?',
    a: 'A pontos méréshez tiszta arcra van szükség. Ha sminkben érkezel, nem gond — a vizsgálat előtt letisztítjuk az arcodat, csak számolj pár plusz perccel.',
  },
  {
    q: 'Mit viszek haza a bőrdiagnosztikáról?',
    a: 'A bőröd állapotának részletes kiértékelését, egy rád szabott kezelési tervet, és egy otthoni arcápolási javaslatot konkrét termékekkel. A termékeket a helyszínen meg is vásárolhatod, de semmi nem kötelező.',
  },
  {
    q: 'Ez ugyanaz, mint az ingyenes online bőranalízis?',
    a: 'Nem. Az online bőranalízis egy kb. 3 perces kérdőív, ami irányt ad és megmondja a bőrtípusodat — ingyenes, bármikor kitöltheted. A bőrdiagnosztika ezzel szemben személyes, géppel végzett vizsgálat a szalonban, aminek a végén konkrét kezelési terv és termékajánló születik.',
  },
  {
    q: 'Helyettesíti a bőrgyógyászati vizsgálatot?',
    a: 'Nem. A bőrdiagnosztika kozmetikai célú felmérés, nem orvosi diagnózis. Súlyos gyulladás vagy tartós bőrprobléma esetén javasoljuk, hogy fordulj bőrgyógyászhoz — illetve ha a tünetek hátterében emésztőrendszeri ok merül fel, gasztroenterológushoz.',
  },
];

// ---- Schema ---------------------------------------------------------------
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Bőrdiagnosztika',
  alternateName: 'Gépi bőranalízis',
  serviceType: 'Bőrdiagnosztika',
  description:
    'Professzionális, géppel végzett bőrdiagnosztika a Beautyflow szalonokban (Buda és Pest). Az arcszkennelés felméri a bőr faggyútermelését, hidratáltságát, pórusait, pigmentfoltjait, ráncait és érzékenységét, majd ez alapján személyre szabott kezelési terv és otthoni termékajánló készül.',
  url,
  // Mindkét szalon szolgáltatója — a provider tömbként is érvényes.
  provider: [
    {
      '@type': 'BeautySalon',
      name: 'Beautyflow Buda',
      telephone: '+36 1 300 9414',
      email: 'info@beautyflow.pro',
      url: 'https://beautyflow.pro/beautyflow-buda',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Vegyész utca 1.',
        addressLocality: 'Budapest',
        addressRegion: 'XI. kerület',
        postalCode: '1116',
        addressCountry: 'HU',
      },
    },
    {
      '@type': 'BeautySalon',
      name: 'Beautyflow Pest',
      telephone: '+36 1 300 9414',
      email: 'info@beautyflow.pro',
      url: 'https://beautyflow.pro/beautyflow-pest',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Reitter Ferenc utca 90.',
        addressLocality: 'Budapest',
        addressRegion: 'XIII. kerület',
        postalCode: '1135',
        addressCountry: 'HU',
      },
      geo: { '@type': 'GeoCoordinates', latitude: '47.5287', longitude: '19.0512' },
    },
  ],
  areaServed: [
    { '@type': 'City', name: 'Budapest' },
    { '@type': 'AdministrativeArea', name: 'XI. kerület' },
    { '@type': 'AdministrativeArea', name: 'XIII. kerület' },
  ],
  offers: {
    '@type': 'Offer',
    price: String(PRICE),
    priceCurrency: 'HUF',
    availability: 'https://schema.org/InStock',
    url,
    description: 'A bőrdiagnosztika díját levonjuk az első kezelés árából.',
  },
  inLanguage: 'hu',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Főoldal', item: 'https://beautyflow.pro/' },
    { '@type': 'ListItem', position: 2, name: 'Bőrdiagnosztika', item: url },
  ],
};
---

<Layout
  title="Bőrdiagnosztika Budapest – gépi bőranalízis kezelési tervvel | Beautyflow"
  description="Ne találgass: professzionális bőrdiagnosztika géppel a Beautyflow szalonokban, Budán és Pesten. 60 perc, 10 000 Ft — amit levonunk az első kezelésed árából. Személyre szabott kezelési terv és otthoni termékajánló."
  newsletter={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- ================= HERO ================= -->
  <section class="relative">
    <div class="absolute inset-0">
      <HeroImage
        src={heroImg}
        alt="Bőrdiagnosztika a Beautyflow szalonban – a kozmetikus a bőranalízis eredményét mutatja a vendégnek"
        priority={true}
        class="h-full w-full object-cover"
      />
      {/* Két rétegű szkrím: a hero fotón a világos tablet-képernyő pont a H1 mögé
          esik, ezért az irányított gradiens önmagában kevés a kontraszthoz. */}
      <div class="absolute inset-0 bg-black/35"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/65 to-transparent"></div>
    </div>

    <div class="relative max-w-[1200px] mx-auto px-5 sm:px-6 py-16 sm:py-24 lg:py-28">
      <div class="max-w-2xl text-white">
        <p class="text-sm font-semibold uppercase tracking-wider text-[#f0a8c4] mb-3">
          Beautyflow Buda &amp; Pest
        </p>
        <h1 class="font-heading text-white text-3xl sm:text-4xl lg:text-5xl leading-tight mb-5">
          Ne találgass — tudd meg, mire van szüksége a bőrödnek
        </h1>
        <p class="text-lg text-white/90 leading-relaxed mb-4">
          Mielőtt megvennéd a századik arcápoló terméket, vagy kipróbálnál egy újabb kezelést a
          problémás bőrödön, érdemes megtalálni a probléma gyökerét.
        </p>
        <p class="text-lg text-white/90 leading-relaxed mb-7">
          A bőrdiagnosztikát azért vezettük be, hogy feltárjuk azokat a területeket, amiket szabad
          szemmel nem lehet látni — és hogy onnantól ne tippelés, hanem terv legyen.
        </p>

        <!-- Ár-badge sor -->
        <div class="flex flex-wrap gap-2.5 mb-8">
          <span class="rounded-full bg-white/15 backdrop-blur px-4 py-2 text-sm font-semibold border border-white/25">
            {DURATION_MIN} perc
          </span>
          <span class="rounded-full bg-white/15 backdrop-blur px-4 py-2 text-sm font-semibold border border-white/25">
            {PRICE.toLocaleString('hu-HU')} Ft
          </span>
          <span class="rounded-full bg-[#c53f75] px-4 py-2 text-sm font-semibold">
            ✓ Levonjuk a kezelésed árából
          </span>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={CTA_HREF}
            data-track="booking_click"
            data-source="bordiagnosztika_hero"
            class="inline-block text-center px-8 py-4 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-full hover:bg-[#a33460] transition-colors"
          >
            Időpontot kérek
          </a>
          <a
            href="/boranalizis"
            class="inline-block text-center px-8 py-4 border-2 border-white/70 text-white font-semibold uppercase tracking-wide rounded-full hover:bg-white/10 transition-colors"
          >
            Előbb kitöltöm az ingyenes tesztet
          </a>
        </div>
        <p class="mt-3 text-sm text-white/70">
          Az online bőranalízis kb. 3 perc, és ingyenes.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= BIZALOM-SÁV ================= -->
  <section class="bg-[#fff9f7] border-b border-[#e7d8df]">
    <div class="max-w-[1200px] mx-auto px-5 sm:px-6 py-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 text-center">
        <div>
          <div class="flex items-center justify-center gap-1 mb-1">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-4 h-4 text-orange-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-sm text-[#334155]">5.0 értékelés · valódi vendégeinktől</p>
        </div>
        <div>
          <p class="font-heading text-lg text-[#c53f75]">Kónya Fanni</p>
          <p class="text-sm text-[#334155]">kozmetikus, szakmai vezető</p>
        </div>
        <div>
          <p class="font-heading text-lg text-[#c53f75]">Koreai kezelésekre szakosodva</p>
          <p class="text-sm text-[#334155]">2015 óta</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MIRE SZÁMÍTS ================= -->
  <section class="max-w-[1000px] mx-auto px-5 sm:px-6 py-14 sm:py-16">
    <h2 class="font-heading text-2xl sm:text-3xl text-[#1e293b] mb-7 text-center">
      Mire számíts a bőrdiagnosztikán?
    </h2>
    <div class="grid sm:grid-cols-3 gap-5">
      {[
        { t: 'Felmérjük a bőröd állapotát', d: 'Professzionális bőranalizáló készülékkel, több megvilágításban — érintés nélkül.' },
        { t: 'Megnézzük a problémás területeket', d: 'Pigmentfolt, gyulladás, pórusok, ráncok, hidratáltság — zónánként.' },
        { t: 'Tervet kapsz, nem tanácsot', d: 'Személyre szabott kezeléssorozat, otthoni arcápolási javaslattal kiegészítve.' },
      ].map((item) => (
        <div class="rounded-2xl border border-[#e7d8df] bg-white p-6">
          <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-[#1e293b] mb-2">{item.t}</h3>
          <p class="text-[#334155] leading-relaxed text-[15px]">{item.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= MI AZ A BŐRDIAGNOSZTIKA + A GÉP ================= -->
  <section class="bg-[#faf7f8] py-14 sm:py-18">
    <div class="max-w-[1200px] mx-auto px-5 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div>
          <h2 class="font-heading text-2xl sm:text-3xl text-[#1e293b] mb-4">
            Mi az a bőrdiagnosztika?
          </h2>
          <p class="text-[#334155] leading-relaxed mb-4">
            A bőrdiagnosztika egy rövid, de alapos vizsgálat, ami során professzionális
            készülékkel nézzük meg a bőröd valós állapotát — azt is, amit puszta szemmel nem
            lehet észrevenni.
          </p>
          <p class="text-[#334155] leading-relaxed mb-4">
            <strong>Nem egy sima konzultáció.</strong> Ez az a pont, ami megalapozza a
            kezeléssorozatod és a termékeidet. Csak azután javaslunk bármilyen kezelést vagy
            terméket, hogy pontosan tudjuk, mire van szüksége a bőrödnek.
          </p>
          <p class="text-[#334155] leading-relaxed">
            A vizsgálathoz a <strong>Skitenic AI bőranalízis-készüléket</strong> használjuk,
            amit a <a
              href={SKINLAB_URL}
              target="_blank"
              rel="noopener"
              class="text-[#c53f75] font-semibold hover:underline">Skinlab Hungary</a
            > forgalmaz. A készülék több megvilágításban fényképezi az arcot, és mesterséges
            intelligenciával elemzi ki a felvételeket — így a felszín alatti elváltozások is
            láthatóvá válnak.
          </p>
        </div>
        <div>
          <ContentImage
            src={gepImg}
            alt="Skitenic AI bőranalízis-készülék a Beautyflow szalonban"
            class="w-full rounded-2xl shadow-lg object-cover aspect-[3/2]"
          />
        </div>
      </div>

      <!-- 8 elemzési szempont -->
