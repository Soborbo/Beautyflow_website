  .faq-item.active .faq-answer-inner { visibility: visible; opacity: 1; transition: visibility 0s, opacity 0.3s ease 0.1s; }
  .faq-item.active { border-color: #c53f75; box-shadow: 0 10px 40px rgba(197, 63, 117, 0.15); transform: translateY(-2px); }
