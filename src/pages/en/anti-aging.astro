---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import LocationsSection from '../../components/LocationsSection.astro';
import { HeroImage, ContentImage, CardImage, FixedImage } from '../../components/images';

// Image imports
import notinoIkon from '../../assets/images/notino-ikon.png';
import googleLogo from '../../assets/images/google-logo.jpg';
import hydrabeautyArckezeles from '../../assets/images/hydrabeauty-arckezeles.jpg';
import antiAgingHero from '../../assets/images/anti-aging-hero.jpg';
import antiAgingJellyMask from '../../assets/images/anti-aging-jelly-mask.jpg';
import hydrabeautyArckezelesBeautyflow from '../../assets/images/hydrabeauty-arckezeles-beautyflow.jpg';
import hydrabeauty from '../../assets/images/hydrabeauty.jpg';
import konyaFanniSzepsegszalonja from '../../assets/images/konya-fanni-szepsegszalonja.jpg';
import konyaFanniKonzultacio from '../../assets/images/konya-fanni-konzultacio.webp';
import mestersegesIntelligencia from '../../assets/images/mesterseges-intelligencia-szortelenito-gep.jpg';
import higienia from '../../assets/images/higienia.jpg';
import nyitva from '../../assets/images/nyitva.jpg';
import notinoLogoSm from '../../assets/images/logok/notino-logo-sm.jpg';
import skinlabLogo from '../../assets/images/logok/skinlab.webp';
import testmeret from '../../assets/images/testmeret.jpg';

const stats = [
  { value: '25+', label: 'recommended from age' },
  { value: '90', label: 'minute treatment' },
  { value: '100%', label: 'satisfied guests' },
  { value: '0', label: 'pain' },
];

const testimonials = [
  {
    text: 'After the Anti Aging treatment, my skin became so firm and radiant that my colleagues thought I had Botox. But it was just the Beautyflow magic!',
    author: 'Krisztina',
  },
  {
    text: 'After 30, I could feel my skin losing its firmness. After the first treatment, I immediately saw the difference – smoother, more youthful face.',
    author: 'Réka',
  },
  {
    text: 'I was afraid of Botox, but the Beautyflow Anti Aging treatment is the perfect alternative. Natural, painless, and the results are fantastic.',
    author: 'Anita',
  }
];

const antiAgingPrice = { service: 'Anti Aging Treatment', duration: '90 min', price: 35000 };

const howItWorks = [
  {
    number: '1.',
    title: 'Cleansing & Toning',
    description: 'The treatment begins with thorough cleansing and toning of the facial skin to remove makeup, impurities, and prepare the skin for active ingredient absorption.'
  },
  {
    number: '2.',
    title: 'Enzymatic Peeling',
    description: 'A gentle enzymatic peel matched to your skin type removes dead skin cells and prepares your skin for deeper active ingredient delivery.'
  },
  {
    number: '3.',
    title: 'Machine Cleansing & Active Ingredients',
    description: 'Deep cleansing with the Hydrabeauty machine not only cleans but also delivers active ingredients into the skin, boosting freshness and renewal.'
  },
  {
    number: '4.',
    title: 'Ultrasound Infusion',
    description: 'Medical-grade active ingredients are delivered into the deeper layers of the skin using ultrasound technology, ensuring maximum absorption and effectiveness.'
  },
  {
    number: '5.',
    title: 'Radiofrequency Treatment',
    description: 'Radiofrequency pushes the active ingredients even deeper while stimulating collagen production and firming the skin from within.'
  },
  {
    number: '6.',
    title: 'Jelly Mask Sealing',
    description: 'The finishing jelly mask calms the skin, fills fine lines, and seals the skin to lock in the active ingredients for lasting results.'
  }
];

const faqs = [
  { question: 'From what age is the Anti Aging treatment recommended?', answer: 'From age 25, as this is when natural collagen production begins to decrease. As prevention, it\'s ideal – the earlier you start, the longer you can maintain your skin\'s youth.' },
  { question: 'Can it really replace Botox?', answer: 'The Anti Aging treatment offers a natural alternative to invasive procedures. With regular treatments, you can delay expensive Botox and plastic surgery interventions while achieving a natural, fresh appearance.' },
  { question: 'How often should I repeat the treatment?', answer: 'For optimal results, once a month is recommended. After the first 3 treatments, you\'ll notice lasting improvement in skin firmness and radiance.' },
  { question: 'Is the treatment painful?', answer: 'The treatment is completely painless! The ultrasound and radiofrequency create a pleasant warmth, while the jelly mask provides a cooling, relaxing sensation.' },
  { question: 'How soon will I see results?', answer: 'Results are visible immediately! After the treatment, your skin will be fresher, firmer, and more radiant. The collagen-stimulating effect continues to improve over the following weeks.' },
  { question: 'Is there any downtime after the treatment?', answer: 'None! After the Anti Aging treatment, you can immediately return to your daily routine. Your skin will look so beautiful that you can go anywhere without makeup.' },
  { question: 'Is it suitable for sensitive skin?', answer: 'Yes! The enzymatic peel and active ingredients are always matched to your skin type. The medical-grade products are specifically gentle.' },
  { question: 'Can it be combined with other treatments?', answer: 'Yes! The Anti Aging treatment combines excellently with Carbon Peeling or Hydratouch for even more impressive results. Ask our specialist about the optimal combination.' },
];
---

<Layout
  title="Anti Aging Treatment Budapest - Skin Rejuvenation with Ultrasound & Radiofrequency | Beautyflow"
  description="Professional Anti Aging treatment in Budapest. Natural skin rejuvenation with ultrasound infusion and radiofrequency. Botox alternative from age 25. Request a free consultation!"
  ogImage="/images/hydrabeauty-arckezeles.jpg"
  lang="en"
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://beautyflow.pro/en"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Anti Aging Treatment",
        "item": "https://beautyflow.pro/en/anti-aging"
      }
    ]
  })} />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Anti Aging Treatment",
    "name": "Anti Aging Treatment Budapest",
    "description": "Professional Anti Aging treatment in Budapest. Natural skin rejuvenation with ultrasound infusion and radiofrequency.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Beautyflow Beauty Salon",
      "image": "https://beautyflow.pro/images/beautyflow-logo.png",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Vegyész u. 1.",
          "addressLocality": "Budapest",
          "postalCode": "1116",
          "addressCountry": "HU"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Reitter Ferenc u. 90.",
          "addressLocality": "Budapest",
          "postalCode": "1135",
          "addressCountry": "HU"
        }
      ],
      "telephone": "+36 1 300 9414",
      "priceRange": "$$"
    },
    "areaServed": {
      "@type": "City",
      "name": "Budapest"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Anti Aging services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Anti Aging Treatment"
          },
          "price": antiAgingPrice.price.toString(),
          "priceCurrency": "HUF"
        }
      ]
    }
  })} />

  <!-- Hero Section -->
  <section class="hero-section relative lg:h-[calc(100dvh-60px)] flex flex-col">
    <div class="flex flex-col lg:flex-row flex-1 min-h-0">
      <!-- Left column: Text content -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center py-6 lg:py-8 order-2 lg:order-1 bg-[#fff9f7]">
        <div class="w-full px-[6%] text-center">
          <!-- Notino Award Badge -->
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full blur-sm opacity-50"></div>
              <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500 p-1 rounded-full">
                <div class="bg-white rounded-full p-1">
                  <FixedImage src={notinoIkon} alt="Notino" class="w-8 h-8" width={32} height={32} />
                </div>
              </div>
            </div>
            <div class="text-left">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Award-winning salon</span>
              </div>
              <span class="text-sm font-bold text-[#c53f75]">Notino "Salon of the Month"</span>
            </div>
          </div>

          <h1 class="text-[#c53f75] font-semibold uppercase tracking-wider text-sm lg:text-base mb-2">
            Anti Aging Treatment in Budapest
          </h1>
          <h2 class="font-heading text-[1.75rem] lg:text-[2.25rem] text-gray-900 mb-3 uppercase leading-tight">
            Youthful, firm skin without Botox or needles
          </h2>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-lg mx-auto">
            From age 25, natural collagen production decreases. Our Anti Aging treatment uses ultrasound and radiofrequency to stimulate skin renewal – visible results from the very first session.
          </p>

          <!-- CTA row -->
          <div class="flex flex-col items-center justify-center gap-2">
            <a
              href="/en/free-consultation"
              class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg text-sm lg:text-base"
            >
              Book your appointment now!
            </a>
            <a
              href="tel:+3613009414"
              class="inline-flex items-center gap-2 text-base lg:text-lg text-[#c53f75] font-bold hover:text-[#a33460] transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +36 1 300 9414
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: Hero image -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2 relative overflow-hidden min-h-[300px] lg:min-h-0">
        <ContentImage
          src={antiAgingJellyMask}
          alt="Anti Aging treatment Budapest - jelly mask"
          class="w-full h-full object-cover"
          priority={true}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:hidden"></div>

        <!-- Google Rating Badge -->
        <div class="absolute bottom-3 left-3 lg:bottom-5 lg:left-5 bg-white/95 backdrop-blur-sm rounded-xl shadow-xl p-2 lg:p-3">
          <div class="flex items-center gap-2">
            <FixedImage src={googleLogo} alt="Google" class="w-7 h-7 lg:w-9 lg:h-9 rounded-full" width={36} height={36} />
            <div>
              <div class="flex items-center gap-1">
                <span class="text-base lg:text-xl font-bold text-gray-900 rating-number" data-target="5.0">0</span>
                <div class="flex">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-2.5 h-2.5 lg:w-3.5 lg:h-3.5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
              <p class="text-[9px] lg:text-[11px] text-gray-600">Based on Google reviews</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="w-full bg-gradient-to-r from-[#c53f75] to-[#a33460] py-4 lg:h-[80px] flex-shrink-0 flex items-center justify-center">
      <div class="max-w-[1000px] mx-auto px-4 w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-8 h-full items-center">
          {stats.map((stat, index) => (
            <div class="text-center stat-item py-2 lg:py-0" style={`animation-delay: ${index * 100}ms`}>
              <p class="text-[24px] lg:text-[32px] font-heading text-white font-bold leading-[0.9] mb-1">
                {stat.value}
              </p>
              <p class="text-white/80 text-[12px] lg:text-[16px] leading-[0.9]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section with Fanni -->
  <section class="section-animate py-12 lg:py-16 bg-gradient-to-br from-[#fdf8f6] via-[#fff] to-[#f8f4f9]">
    <div class="max-w-[1100px] mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <div class="w-full lg:w-2/5 flex-shrink-0 relative">
            <ContentImage
              src={konyaFanniSzepsegszalonja}
              alt="Fanni Kónya Anti Aging specialist"
              class="w-full h-auto lg:absolute lg:inset-0 lg:h-full object-cover object-top"
            />
            <div class="lg:hidden flex items-center gap-3 p-4 bg-gray-50 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold text-sm mb-0">Fanni Kónya</p>
                <p class="text-gray-500 text-xs mb-0">CEO</p>
              </div>
            </div>
          </div>
          <div class="w-full lg:w-3/5 p-6 lg:p-8 flex flex-col justify-center">
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              If you look in the mirror and see a more tired face than you'd like – you're not alone. <strong>From age 25, the skin's natural collagen production gradually decreases</strong>, and sooner or later it shows: fine lines, dull skin, loss of firmness.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              Our Anti Aging treatment provides the solution: <strong>we deliver medical-grade active ingredients into the deeper layers of the skin</strong> using ultrasound and radiofrequency, stimulating collagen production. The result? Firm, radiant, youthful skin – without needles or invasive procedures.
            </p>
            <p class="text-gray-700 mb-6 text-base leading-relaxed">
              <strong>If you want to delay Botox and plastic surgery, or simply prevent the signs of aging, this treatment is for you!</strong>
            </p>
            <div class="hidden lg:flex items-center gap-3 pt-4 border-t border-gray-200">
              <div class="w-12 h-12 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold mb-0">Fanni Kónya</p>
                <p class="text-gray-500 text-sm mb-0">CEO</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 1: Prevention -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage src={hydrabeautyArckezelesBeautyflow} alt="Anti Aging prevention from age 25" class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105" />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">Prevention, not correction</h2>
          <p class="text-gray-700 mb-6">From age 25, the skin's natural collagen production begins to decrease. The Anti Aging treatment <strong>stimulates collagen and elastin formation</strong>, helping your skin maintain its youthfulness and elasticity. The earlier you start, the more effective the prevention!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 2: Botox alternative -->
  <section class="section-animate bg-gray-50">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 order-2 lg:order-1">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">Natural alternative to Botox</h2>
          <p class="text-gray-700 mb-6">No need to reach for the needle! The Anti Aging treatment <strong>can delay the need for expensive invasive procedures</strong>: radiofrequency and ultrasound infusion naturally firm the skin and fill fine lines.</p>
          <div class="text-center">
            <a href="/en/free-consultation" class="inline-block px-6 py-3 bg-[#c53f75] text-white font-semibold uppercase text-sm rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg">Request Free Consultation</a>
          </div>
        </div>
      </div>
      <div class="w-full lg:w-1/2 relative overflow-hidden order-1 lg:order-2">
        <ContentImage src={hydrabeauty} alt="Anti Aging Botox alternative" class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105" />
      </div>
    </div>
  </section>

  <!-- Benefits Section 3: Radiant skin -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage src={antiAgingHero} alt="Anti Aging radiant skin" class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105" />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">Fresh, radiant, firm skin</h2>
          <p class="text-gray-700 mb-6">As a result of the treatment, <strong>your skin regains its firmness, radiance, and freshness</strong>. Medical-grade ingredients nourish the skin from deep within, while the jelly mask seals and preserves the results. You'll feel the difference from the very first session.</p>
          <div class="text-center">
            <a href="/en/free-consultation" class="inline-block px-6 py-3 bg-[#c53f75] text-white font-semibold uppercase text-sm rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg">Request Free Consultation</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-16 bg-gradient-to-b from-[#f9f5f3] to-white">
    <div class="max-w-[1000px] mx-auto px-4">
      <h2 class="font-heading text-2xl lg:text-3xl text-gray-900 mb-4 text-center uppercase">Anti Aging Treatment Price</h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">Complex skin rejuvenation with ultrasound and radiofrequency</p>

      <div class="max-w-md mx-auto">
        <div class="bg-white rounded-lg p-6 shadow-md border-l-4 border-[#c53f75] hover:shadow-lg transition-shadow">
          <div class="flex justify-between items-center">
            <div>
              <span class="text-gray-800 font-medium block text-lg">{antiAgingPrice.service}</span>
              <span class="text-gray-500 text-sm">{antiAgingPrice.duration}</span>
            </div>
            <span class="text-[#c53f75] font-bold text-2xl whitespace-nowrap">{antiAgingPrice.price.toLocaleString('hu-HU')} Ft</span>
          </div>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a href="/en/free-consultation" class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg">Book Appointment</a>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="how-it-works-section relative overflow-hidden">
    <div class="lg:hidden">
      <ContentImage src={hydrabeautyArckezeles} alt="Anti Aging treatment process" class="w-full h-64 object-cover object-top" />
    </div>
    <div class="hidden lg:block absolute inset-0">
      <ContentImage src={hydrabeautyArckezeles} alt="" class="w-full h-full object-cover object-[center_30%]" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#e8e4e1] via-[#e8e4e1]/95 to-transparent"></div>
    </div>
    <div class="lg:hidden absolute inset-0 top-64 bg-[#e8e4e1]"></div>

    <div class="relative z-10 py-12 lg:py-16">
      <div class="max-w-[1200px] mx-auto px-4">
        <h2 class="font-heading text-3xl lg:text-4xl text-[#1e3a5f] mb-10 text-center uppercase">How does it work?</h2>
        <div class="flex flex-col lg:flex-row gap-8">
          <div class="lg:w-[60%]">
            <div class="hidden md:grid md:grid-cols-2 gap-4 md:gap-5">
              {howItWorks.map((step) => (
                <div class="bg-white rounded-lg shadow-md p-5 md:p-6">
                  <p class="text-[#1e3a5f] font-bold text-sm mb-1">{step.number}</p>
                  <h3 class="font-heading text-base md:text-lg text-[#1e3a5f] mb-2 uppercase">{step.title}</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">{step.description}</p>
                </div>
              ))}
            </div>
            <div class="md:hidden overflow-x-auto scrollbar-hide -mx-4 px-4">
              <div class="flex gap-4 pb-4" style="width: max-content;">
