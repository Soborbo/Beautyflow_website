---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import LocationsSection from '../../components/LocationsSection.astro';
import { ContentImage, CardImage, HeroImage, FixedImage } from '../../components/images';
import { type Locale, getLocalizedPath } from '../../i18n';

const lang: Locale = 'en';

// Image imports
import biopenHero from '../../assets/images/biopen-hero.png';
import biopenNewHero from '../../assets/images/biopen-new-hero.jpg';
import biopenKezelesKozben from '../../assets/images/biopen-feature-1.png';
import biopenEredmeny from '../../assets/images/biopen-feature-2.png';
import biopenHatoanyag from '../../assets/images/hydrabeauty.jpg'; // PLACEHOLDER
import biopenRancokKezeles from '../../assets/images/biopen-rancok-kezeles.jpg';
import biopenHatter from '../../assets/images/biopen-hogyan-mukodik.jpg';
import konyaFanniSzepsegszalon from '../../assets/images/Konya-Fanni-szepsegszalon.jpg';
import konyaFanniSzepsegszalonja from '../../assets/images/konya-fanni-szepsegszalonja.jpg';
import konyaFanniKonzultacio from '../../assets/images/konya-fanni-konzultacio.webp';
import notinoIkon from '../../assets/images/notino-ikon.png';
import googleLogo from '../../assets/images/google-logo.jpg';
import higienia from '../../assets/images/higienia.jpg';
import testmeret from '../../assets/images/testmeret.jpg';
import nyitva from '../../assets/images/nyitva.jpg';
import notinoLogoSm from '../../assets/images/logok/notino-logo-sm.jpg';
import skinlab from '../../assets/images/logok/skinlab.webp';
import biopenMikrotusVsSima from '../../assets/images/biopen-mikrotus-vs-sima.jpg';
import hydrabeautyArckezelesBeautyflow from '../../assets/images/hydrabeauty-arckezeles-beautyflow.jpg'; // PLACEHOLDER
import mestersegesIntelligencia from '../../assets/images/mesterseges-intelligencia-szortelenito-gep.jpg';

const stats = [
  { value: '10+ years', label: 'experience' },
  { value: '75', label: 'minute treatment' },
  { value: '20+', label: 'active ingredients' },
  { value: '25+', label: 'years of age and up' },
];

const testimonials = [
  {
    text: 'After the BioPen Q2 treatment, my skin looks so much firmer and younger. My expression lines have visibly faded, and the texture of my skin has also improved. I am very satisfied!',
    author: 'Andrea',
  },
  {
    text: 'I had been looking for an effective anti-aging solution for years. The microneedling treatment was painless thanks to the numbing cream, and the result is stunning. My skin is glowing!',
    author: 'Timea',
  },
  {
    text: 'My eye area was always a problem - tired, saggy. Fanni Konya treated it with the BioPen Q2 in a targeted way, and I already felt the difference after the first session. I became a regular!',
    author: 'Nora',
  }
];

const singlePrices = [
  { area: 'BioPen Q2 – Microneedling Mesotherapy', price: '35 000 Ft', description: '75-minute comprehensive treatment' },
];

const packages = [
  { area: '4-session package', originalPrice: '140 000', price: '112 000 Ft', discount: '-20%' },
];

const howItWorks = [
  {
    number: '1.',
    title: 'Consultation & Numbing',
    description: 'We assess your skin condition, select the appropriate active ingredients, and then numb the treatment area with lidocaine cream for a painless experience.'
  },
  {
    number: '2.',
    title: 'Microneedling Mesotherapy',
    description: 'The BioPen Q2 microneedles open microchannels in the skin while delivering medical-grade active ingredients into the deep layers. They stimulate collagen and elastin production.'
  },
  {
    number: '3.',
    title: 'Electroporation & LED',
    description: 'Electroporation enhances active ingredient absorption, while LED light therapy (blue or red) specifically targets the given skin concern - acne or anti-aging.'
  },
  {
    number: '4.',
    title: 'Closing & Aftercare',
    description: 'We finish the treatment with a soothing serum and sunscreen. We discuss your at-home aftercare routine in detail to ensure lasting results.'
  }
];

const faqs = [
  { question: 'What is BioPen Q2?', answer: 'BioPen Q2 is a 3-in-1 cosmetic device that combines microneedling mesotherapy, electroporation, and LED light therapy in a single treatment. It delivers medical-grade active ingredients into the deep layers of the skin, stimulating collagen and elastin production.' },
  { question: 'Is the treatment painful?', answer: 'No. Before the treatment, we apply a lidocaine numbing cream, making the microneedling treatment painless. Electroporation may give a mild tingling sensation, but it can be turned off if uncomfortable.' },
  { question: 'Who is BioPen Q2 recommended for?', answer: 'We recommend it for ages 25 and above, when natural collagen production slows down. It is excellent for wrinkles, scars, pigmentation spots, dehydrated skin, enlarged pores, and eye area problems.' },
  { question: 'What active ingredients do you work with?', answer: 'We work with 20 types of medical-grade ampoules: collagen, hyaluronic acid, vitamin C, peptides, lifting agents, and special blends for dehydrated, pigmented, or acne-prone skin.' },
  { question: 'How many treatments are needed?', answer: 'Visible improvement can be seen after the first treatment. For optimal results, a course of 4 sessions is recommended, every 3-4 weeks. After that, 1-2 maintenance treatments per year are sufficient.' },
  { question: 'When can the treatment be performed?', answer: 'In winter we use microneedles (deeper layers), in summer we use nanoneedles (surface treatment). This way it can be performed year-round, adjusting the intensity to the season.' },
  { question: 'What is the difference between microneedles and nanoneedles?', answer: 'Microneedles penetrate deeper layers and deliver more intense results - we use them in winter. Nanoneedles work in the surface layers, are gentler, and are safe to use in summer as well.' },
  { question: 'Can it be combined with other treatments?', answer: 'BioPen Q2 is a comprehensive treatment on its own and is not combined with other electro-cosmetic procedures. The device\'s 3 functions (microneedling, electroporation, LED) complement each other.' },
  { question: 'Is there any downtime?', answer: 'Minimal. After the treatment, mild redness may appear, which subsides within a few hours. You can resume your normal routine the next day.' },
  { question: 'Why should I come to Beautyflow?', answer: 'We perform a 75-minute treatment with numbing, work with 20 types of medical-grade active ingredients, and include LED light therapy in the price. In our award-winning salon, you get the premium of the premium.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title="BioPen Q2 Microneedling Mesotherapy Budapest - Skin Rejuvenation | Beautyflow"
  description="BioPen Q2 microneedling mesotherapy in Budapest. 3-in-1 treatment: microneedling + electroporation + LED light therapy. 20 medical-grade active ingredients, 75-minute luxury program. Request a free consultation!"
  ogImage="/images/hydrabeauty-arckezeles.jpg"
  lang="en"
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://beautyflow.pro/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "BioPen Q2 Treatment",
        "item": "https://beautyflow.pro/en/biopen-q2/"
      }
    ]
  })} />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "BioPen Q2 Microneedling Mesotherapy",
    "name": "BioPen Q2 Treatment Budapest",
    "description": "BioPen Q2 microneedling mesotherapy in Budapest. 3-in-1 treatment: microneedling + electroporation + LED light therapy. With medical-grade active ingredients.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Beautyflow Beauty Salon",
      "image": "https://beautyflow.pro/images/beautyflow-logo.png",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Vegyesz u. 1.",
          "addressLocality": "Budapest",
          "postalCode": "1116",
          "addressCountry": "HU"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Reitter Ferenc u. 90.",
          "addressLocality": "Budapest",
          "postalCode": "1135",
          "addressCountry": "HU"
        }
      ],
      "telephone": "+36 1 300 9414",
      "priceRange": "$$$"
    },
    "areaServed": {
      "@type": "City",
      "name": "Budapest"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "BioPen Q2 services",
      "itemListElement": singlePrices.map(item => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": item.area
        },
        "price": item.price.replace(/[^0-9]/g, ''),
        "priceCurrency": "HUF"
      }))
    }
  })} />

  <!-- Hero Section -->
  <section class="hero-section relative lg:h-[calc(100dvh-60px)] flex flex-col">
    <div class="flex flex-col lg:flex-row flex-1 min-h-0">
      <!-- Left column: Text content -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center py-6 lg:py-8 order-2 lg:order-1 bg-[#fff9f7]">
        <div class="w-full px-[6%] text-center">
          <!-- Notino Award Badge -->
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full blur-sm opacity-50"></div>
              <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500 p-1 rounded-full">
                <div class="bg-white rounded-full p-1">
                  <FixedImage
                    src={notinoIkon}
                    alt="Notino"
                    width={32}
                    height={32}
                    class="w-8 h-8"
                  />
                </div>
              </div>
            </div>
            <div class="text-left">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Award-winning salon</span>
              </div>
              <span class="text-sm font-bold text-[#c53f75]">Notino "Salon of the Month"</span>
            </div>
          </div>

          <h1 class="text-[#c53f75] font-semibold uppercase tracking-wider text-sm lg:text-base mb-2">
            BioPen Q2 Microneedling Mesotherapy in Budapest
          </h1>
          <h2 class="font-heading text-[1.75rem] lg:text-[2.25rem] text-gray-900 mb-3 uppercase leading-tight">
            Rejuvenate your skin from the deep layers
          </h2>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-lg mx-auto">
            3-in-1 treatment: microneedling + electroporation + LED light therapy. With 20 medical-grade active ingredients, tailored to your skin concern.
          </p>

          <!-- CTA row -->
          <div class="flex flex-col items-center justify-center gap-2">
            <a
              href="/en/free-consultation/"
              class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg text-sm lg:text-base"
            >
              Book your appointment now!
            </a>
            <a
              href="tel:+3613009414"
              class="inline-flex items-center gap-2 text-base lg:text-lg text-[#c53f75] font-bold hover:text-[#a33460] transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +36 1 300 9414
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: Hero image -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2 relative overflow-hidden min-h-[300px] lg:min-h-0">
        <ContentImage
          src={biopenNewHero}
          alt="BioPen Q2 microneedling mesotherapy Budapest"
          class="w-full h-full object-cover"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:hidden"></div>

        <!-- Google Rating Badge -->
        <div class="absolute bottom-3 left-3 lg:bottom-5 lg:left-5 bg-white/95 backdrop-blur-sm rounded-xl shadow-xl p-2 lg:p-3">
          <div class="flex items-center gap-2">
            <FixedImage
              src={googleLogo}
              alt="Google"
              width={36}
              height={36}
              class="w-7 h-7 lg:w-9 lg:h-9 rounded-full"
            />
            <div>
              <div class="flex items-center gap-1">
                <span class="text-base lg:text-xl font-bold text-gray-900 rating-number" data-target="5.0">0</span>
                <div class="flex">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-2.5 h-2.5 lg:w-3.5 lg:h-3.5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
              <p class="text-[9px] lg:text-[11px] text-gray-600">Based on Google reviews</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="w-full bg-gradient-to-r from-[#c53f75] to-[#a33460] py-4 lg:h-[80px] flex-shrink-0 flex items-center justify-center">
      <div class="max-w-[1000px] mx-auto px-4 w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-8 h-full items-center">
          {stats.map((stat, index) => (
            <div class="text-center stat-item py-2 lg:py-0" style={`animation-delay: ${index * 100}ms`}>
              <p class="text-[24px] lg:text-[32px] font-heading text-white font-bold leading-[0.9] mb-1">
                {stat.value}
              </p>
              <p class="text-white/80 text-[12px] lg:text-[16px] leading-[0.9]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section with Fanni -->
  <section class="section-animate py-12 lg:py-16 bg-gradient-to-br from-[#fdf8f6] via-[#fff] to-[#f8f4f9]">
    <div class="max-w-[1100px] mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <!-- Image -->
          <div class="w-full lg:w-2/5 flex-shrink-0 relative">
            <ContentImage
              src={konyaFanniSzepsegszalon}
              alt="Fanni Konya, BioPen Q2 specialist"
              class="w-full h-auto lg:absolute lg:inset-0 lg:h-full object-cover object-top"
            />
            <!-- Mobile signature -->
            <div class="lg:hidden flex items-center gap-3 p-4 bg-gray-50 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold text-sm mb-0">Fanni Konya</p>
                <p class="text-gray-500 text-xs mb-0">managing director</p>
              </div>
            </div>
          </div>
          <!-- Text content -->
          <div class="w-full lg:w-3/5 p-6 lg:p-8 flex flex-col justify-center">
            <p class="text-gray-700 mb-5 leading-relaxed" style="font-size: 18px;">
              After age 25, our natural collagen production slows down - from that point on, we work with what we have. That is why daily skincare alone is not enough: the active ingredients need to reach the deep layers of the skin to bring real change. That is exactly what BioPen Q2 is for.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              It is a <strong>microneedling mesotherapy device that works with medical-grade active ingredients</strong>. The microneedles open microchannels in the skin, stimulate collagen and elastin production, while the active ingredients - whether hyaluronic acid, peptides, vitamin C, or collagen - reach the deepest layers of the skin.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              But BioPen Q2 is not just microneedling - <strong>electroporation and LED light therapy are also built into</strong> the device. Electroporation enhances active ingredient absorption, blue LED treats acne-prone skin, and red LED strengthens the anti-aging effect. Three functions, one device, one treatment.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              We work with 20 types of medical-grade ampoules - <strong>there is no skin concern we cannot address</strong>. Wrinkles, scars, pigmentation spots, dehydration, enlarged pores, eye area - there is the right active ingredient combination for everything.
            </p>
            <p class="text-gray-700 mb-6 text-base leading-relaxed">
              <strong>If you feel that your skin is not what it used to be and creams are no longer enough - BioPen Q2 microneedling mesotherapy is the next level.</strong>
            </p>
            <!-- Desktop signature -->
            <div class="hidden lg:flex items-center gap-3 pt-4 border-t border-gray-200">
              <div class="w-12 h-12 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold mb-0">Fanni Konya</p>
                <p class="text-gray-500 text-sm mb-0">managing director</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 1: Anti-aging - Image left, Text right -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
          src={biopenHero}
          alt="BioPen Q2 anti-aging treatment - against wrinkles and aging"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">
            Against wrinkles and aging - from the deep layers
          </h2>
          <p class="text-gray-700 mb-4">
            The BioPen Q2 microneedles <strong>open microchannels in the skin</strong>, through which medical-grade active ingredients - collagen, hyaluronic acid, peptides - reach the deepest layers of the skin. This is not simple surface care: the active ingredients work where wrinkles originate.
          </p>
          <p class="text-gray-700 mb-4">
            The mechanical stimulation of the microneedles <strong>triggers natural collagen and elastin production</strong>. These are the two proteins responsible for skin firmness and elasticity - and whose production slows down after age 25.
          </p>
          <p class="text-gray-700 mb-6">
            The result is not an instant miracle, but <strong>gradual, lasting skin rejuvenation</strong>: expression lines fade, the skin becomes firmer and more elastic, and facial contours regain their former definition.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 2: Scars and pigmentation - Text left, Image right -->
  <section class="section-animate bg-gray-50">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 order-2 lg:order-1">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">
            Get rid of scars and pigmentation spots
          </h2>
          <p class="text-gray-700 mb-4">
            Microneedling mesotherapy is not just anti-aging: our <strong>vitamin C and special brightening ampoules</strong> specifically target pigmentation spots and uneven skin tone. The active ingredients reach exactly where they are needed through the opened microchannels.
          </p>
          <p class="text-gray-700 mb-4">
            It also works effectively on acne scars and other surface scars: the microneedles <strong>stimulate scar tissue remodeling</strong>, while collagen-stimulating active ingredients accelerate regeneration. For scar treatment, we recommend a course of 4 sessions.
          </p>
          <p class="text-gray-700 mb-6">
            <strong>Enlarged pores, oily skin, eye area problems</strong> - there is the right medical-grade ampoule for each one. During the consultation, we assess your skin condition and select the active ingredient combination tailored specifically to you.
          </p>
          <div class="text-center">
            <a
              href="/en/free-consultation/"
              class="inline-block px-6 py-3 bg-[#c53f75] text-white font-semibold uppercase text-sm rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg"
            >
              Request a Free Consultation
            </a>
          </div>
        </div>
      </div>
      <div class="w-full lg:w-1/2 relative overflow-hidden order-1 lg:order-2">
        <ContentImage
          src={biopenRancokKezeles}
          alt="BioPen Q2 scar treatment and pigmentation treatment results"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
    </div>
  </section>

  <!-- Benefits Section 3: Active ingredients - Image left, Text right -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
          src={biopenMikrotusVsSima}
          alt="BioPen Q2 microneedling ingredient delivery vs. regular absorption - microneedles deliver ingredients deep into the skin"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">
            20 types of medical-grade active ingredients
          </h2>
          <p class="text-gray-700 mb-4">
            The true power of BioPen Q2 lies in the <strong>20 types of medical-grade ampoules</strong>. These are not drugstore creams: they are concentrated active ingredients specifically developed for microneedling delivery, working where traditional skincare cannot reach.
          </p>
