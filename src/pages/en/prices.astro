<Layout
  title="Prices - Beautyflow Beauty Salon Budapest"
  description="Beautyflow beauty salon price list: laser hair removal, cosmetic treatments, plasma therapy, carbon peeling, tattoo and pigment spot removal prices in Budapest."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#f0ebe8] to-[#e8e0dc] py-8 lg:py-12">
    <div class="container mx-auto px-4 text-center">
      <h1 class="font-heading text-3xl lg:text-5xl text-gray-900 mb-3">
        Our Prices
      </h1>
      <p class="text-gray-600 max-w-2xl mx-auto text-sm lg:text-base">
        Transparent pricing, quality services. Choose a treatment and book your appointment online!
      </p>
      <p class="text-gray-500 text-xs lg:text-sm mt-3">
        Valid from {priceListValidFrom}
      </p>
    </div>
  </section>

  <!-- VIP Loyalty Banner -->
  <section class="bg-gradient-to-r from-[#c53f75] to-[#a33460] py-5">
    <div class="container mx-auto px-4 text-center">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <div class="flex items-center gap-2">
          <span class="text-2xl">&#11088;</span>
          <span class="text-white font-heading text-lg sm:text-xl font-bold uppercase">VIP Loyalty Program</span>
        </div>
        <span class="hidden sm:block w-px h-6 bg-white/30"></span>
        <p class="text-white/90 text-sm sm:text-base">
          Collect a stamp after every treatment! <strong class="text-white">15 stamps = lifetime 10% discount</strong> on all treatments.
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky Navigation -->
  <nav id="price-nav" class="sticky top-[60px] z-40 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
    <div class="container mx-auto px-4">
      <div class="flex gap-1 overflow-x-auto py-3 scrollbar-hide">
        {categories.map((cat, index) => (
          <button
            class={`price-nav-btn whitespace-nowrap px-4 py-2 text-sm font-medium rounded-full transition-all ${index === 0 ? 'active' : ''}`}
            data-target={cat.id}
            data-color={cat.color.primary}
            style={index === 0 ? `background-color: ${cat.color.primary}; color: white;` : ''}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </nav>

  <main class="py-8 lg:py-12 bg-gray-50">
    <div class="container mx-auto px-4 max-w-5xl">

      <!-- Laser Hair Removal Packages -->
      <section id="laser-packages" class="price-section mb-12 p-6 rounded-2xl" style={`background-color: ${categoryColors['lezeres'].bg};`}>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-8 rounded-full" style={`background-color: ${categoryColors['lezeres'].primary};`}></div>
          <h2 class="font-heading text-2xl lg:text-3xl text-gray-900">Laser hair removal packages</h2>
        </div>

        <!-- Free consultation -->
        <div class="bg-white rounded-lg p-5 shadow-sm border-2 border-dashed border-blue-300 mb-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <h3 class="font-semibold text-lg text-gray-900 mb-1">{freeConsultation.name}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{freeConsultation.zones}</p>
            </div>
            <div class="text-right whitespace-nowrap">
              <span class="text-2xl font-bold text-blue-600">{freeConsultation.price}</span>
              <span class="block text-gray-500 text-sm">{freeConsultation.duration}</span>
            </div>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {laserPackages.map((pkg) => (
