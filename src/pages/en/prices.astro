// Schema.org – Service Catalog with Offers (all services + both locations)
const toOffers = (items: TreatmentItem[]) =>
  items
    .filter((item) => /\d/.test(item.price))
    .map((item) => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": item.name, ...(item.desc ? { "description": item.desc } : {}) },
      "price": item.price.replace(/[^\d]/g, ''),
      "priceCurrency": "HUF",
    }));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  "name": "Beautyflow Beauty Salon",
  "url": "https://beautyflow.pro/en/prices",
