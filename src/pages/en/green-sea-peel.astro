---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import LocationsSection from '../../components/LocationsSection.astro';
import { ContentImage, CardImage, HeroImage, FixedImage } from '../../components/images';
import { type Locale, getLocalizedPath } from '../../i18n';

const lang: Locale = 'en';

// Image imports
import greenSeaPeelHero from '../../assets/images/green-sea-peel-new-hero.jpg';
import greenSeaPeelOldHero from '../../assets/images/green-sea-peel-hero.jpg';
import greenSeaPeelFeature from '../../assets/images/green-sea-peel-feature.jpg';
import greenSeaPeelHamlasztas from '../../assets/images/green-sea-peel-hamlasztas.jpg';
import greenSeaPeelEgyAlkalom from '../../assets/images/green-sea-peel-egy-alkalom.jpg';
import greenSeaPeelHatter from '../../assets/images/originals/carbon-peeling-hatter.webp'; // PLACEHOLDER
import konyaFanniSzepsegszalon from '../../assets/images/Konya-Fanni-szepsegszalon.jpg';
import konyaFanniSzepsegszalonja from '../../assets/images/konya-fanni-szepsegszalonja.jpg';
import konyaFanniKonzultacio from '../../assets/images/konya-fanni-konzultacio.webp';
import notinoIkon from '../../assets/images/notino-ikon.png';
import googleLogo from '../../assets/images/google-logo.jpg';
import higienia from '../../assets/images/higienia.jpg';
import testmeret from '../../assets/images/testmeret.jpg';
import nyitva from '../../assets/images/nyitva.jpg';
import notinoLogoSm from '../../assets/images/logok/notino-logo-sm.jpg';
import skinlab from '../../assets/images/logok/skinlab.webp';
import hydrabeautyArckezelesBeautyflow from '../../assets/images/hydrabeauty-arckezeles-beautyflow.jpg'; // PLACEHOLDER
import mestersegesIntelligencia from '../../assets/images/mesterseges-intelligencia-szortelenito-gep.jpg';


const stats = [
  { value: '10+ yrs', label: 'experience' },
  { value: '75', label: 'minute treatment' },
  { value: '100%', label: 'premium ingredients' },
  { value: '3', label: 'peel levels' },
];

const testimonials = [
  {
    text: 'After the Green Sea Peel treatment, my skin was completely renewed. My pigmentation spots became lighter, and my skin is smooth and radiant. I love the result!',
    author: 'Zsófi',
  },
  {
    text: 'I had been struggling with acne scars for years. Already after the first treatment, I saw a huge difference. The scars shrank and my skin texture visibly improved.',
    author: 'Réka',
  },
  {
    text: 'I was initially afraid of the peeling, but it was worth it! My skin looks like it has been completely replaced. Fanni Kónya explained everything in detail and I felt safe throughout.',
    author: 'Kata',
  }
];

const singlePrices = [
  { area: 'Green Sea Peel – Light', price: '30 000 Ft', description: 'Light peel, powder-like exfoliation' },
  { area: 'Green Sea Peel – Medium', price: '30 000 Ft', description: 'Medium peel' },
  { area: 'Green Sea Peel – Deep', price: '30 000 Ft', description: 'Intensive, sheet-like peeling' },
];

const packages = [
  { area: '4-session course (Light)', originalPrice: '120 000', price: '96 000 Ft', discount: '-20%' },
  { area: '4-session course (Medium)', originalPrice: '120 000', price: '96 000 Ft', discount: '-20%' },
  { area: '4-session course (Deep)', originalPrice: '120 000', price: '96 000 Ft', discount: '-20%' },
];

const howItWorks = [
  {
    number: '1.',
    title: 'Skin Analysis & Cleansing',
    description: 'We cleanse and tone your skin, then assess its condition. We discuss which peel level (light, medium or deep) is most suitable for you.'
  },
  {
    number: '2.',
    title: 'Green Sea Peel Application',
    description: 'We apply the Korean Green Sea Peel mixture and massage it into the skin for 7-10 minutes. The sea sponge micro-needles open microchannels, triggering cell regeneration.'
  },
  {
    number: '3.',
    title: 'Calming & Mask',
    description: 'We calm the skin with a cicaplast sheet mask and sensitive-care products. LED light therapy is also applied to accelerate healing.'
  },
  {
    number: '4.',
    title: 'Finishing & Aftercare',
    description: 'We finish the treatment with sunscreen and thoroughly discuss your at-home aftercare routine. Peeling begins after 3-4 days and lasts about a week – during which your skin is completely renewed.'
  }
];

const faqs = [
  { question: 'How painful is the Green Sea Peel treatment?', answer: 'The treatment involves an uncomfortable sensation – many compare it to being scrubbed with glass splinters. The sea sponge micro-needles cause this feeling during massage, but the treatment only lasts 7-10 minutes in total.' },
  { question: 'Who is Green Sea Peel recommended for?', answer: 'It is excellent for skin with pigmentation spots, scars (acne scars, chickenpox scars), oily skin, enlarged pores, and also as an anti-aging treatment. It can be performed regardless of age.' },
  { question: 'Who should NOT have this treatment?', answer: 'It cannot be performed on rosacea-prone, very sensitive, or actively acne-affected skin, in case of herpes, or with crab/shellfish/algae allergy. Moles must be avoided, and it is not recommended for skin with too many moles.' },
  { question: 'How many treatments are needed?', answer: 'Even after a single treatment, complete skin renewal is noticeable. For scars, a 4-session course is recommended, every 28 days. After that, 1 maintenance treatment per year is sufficient.' },
  { question: 'What is the peeling like?', answer: 'Peeling begins after 3-4 days and lasts about a week. With Light treatment, it is powder-like; with Medium, moderate; with Deep treatment, sheet-like peeling is expected – old skin comes off in large pieces, revealing fresh, renewed skin underneath.' },
  { question: 'What should I do after the treatment?', answer: 'Only lukewarm water and sunscreen are permitted. Moisturiser, cleanser, retinol, and any skincare products are strictly prohibited during the peeling period. The process must be left to the skin\'s self-healing mechanism.' },
  { question: 'When can the treatment be performed?', answer: 'Exclusively during the winter months, from November to May. It cannot be performed in summer due to increased UV radiation.' },
  { question: 'Is there downtime?', answer: 'Yes, peeling lasting 3-7 days is expected after treatment, during which redness also occurs. It is not recommended to have the treatment done before important events during this time.' },
  { question: 'Can it be combined with other treatments?', answer: 'Green Sea Peel is a comprehensive treatment on its own. We also supplement it with LED light therapy, included in the price. It cannot be combined with other treatments simultaneously.' },
  { question: 'What is included in the treatment price?', answer: 'You receive a 75-minute treatment with premium Korean and German products, supplemented with LED light therapy. At the end of the treatment, the skin is carefully calmed with sensitive-care products.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  lang="en"
  title="Green Sea Peel Treatment Budapest - Sea Sponge Micro-Needle Exfoliation | Beautyflow"
  description="Premium Green Sea Peel treatment in Budapest. Korean sea sponge micro-needle skin renewal for pigmentation spots, acne scars, and wrinkles. 75-minute luxury program with LED light therapy. Request a free consultation!"
  ogImage="/images/hydrabeauty-arckezeles.jpg"
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://beautyflow.pro/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Green Sea Peel Treatment",
        "item": "https://beautyflow.pro/en/green-sea-peel/"
      }
    ]
  })} />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Green Sea Peel",
    "name": "Green Sea Peel Treatment Budapest",
    "description": "Premium Green Sea Peel treatment in Budapest. Korean sea sponge micro-needle skin renewal for pigmentation spots, acne scars, and wrinkles.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Beautyflow Beauty Salon",
      "image": "https://beautyflow.pro/images/beautyflow-logo.png",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Vegyész u. 1.",
          "addressLocality": "Budapest",
          "postalCode": "1116",
          "addressCountry": "HU"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Reitter Ferenc u. 90.",
          "addressLocality": "Budapest",
          "postalCode": "1135",
          "addressCountry": "HU"
        }
      ],
      "telephone": "+36 1 300 9414",
      "priceRange": "$$$"
    },
    "areaServed": {
      "@type": "City",
      "name": "Budapest"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Green Sea Peel services",
      "itemListElement": singlePrices.map(item => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": item.area
        },
        "price": item.price.replace(/[^0-9]/g, ''),
        "priceCurrency": "HUF"
      }))
    }
  })} />

  <!-- Hero Section -->
  <section class="hero-section relative lg:h-[calc(100dvh-60px)] flex flex-col">
    <div class="flex flex-col lg:flex-row flex-1 min-h-0">
      <!-- Left column: Text content -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center py-6 lg:py-8 order-2 lg:order-1 bg-[#fff9f7]">
        <div class="w-full px-[6%] text-center">
          <!-- Notino Award Badge -->
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full blur-sm opacity-50"></div>
              <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500 p-1 rounded-full">
                <div class="bg-white rounded-full p-1">
                  <FixedImage src={notinoIkon} alt="Notino" width={32} height={32} class="w-8 h-8" />
                </div>
              </div>
            </div>
            <div class="text-left">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Award-winning salon</span>
              </div>
              <span class="text-sm font-bold text-[#c53f75]">Notino "Salon of the Month"</span>
            </div>
          </div>

          <h1 class="text-[#c53f75] font-semibold uppercase tracking-wider text-sm lg:text-base mb-2">
            Green Sea Peel Treatment in Budapest
          </h1>
          <h2 class="font-heading text-[1.75rem] lg:text-[2.25rem] text-gray-900 mb-3 uppercase leading-tight">
            Get completely new skin
          </h2>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-lg mx-auto">
            Your old, damaged skin peels off, revealing fresh, radiant skin underneath. An effective treatment for pigmentation spots, acne scars, and wrinkles.
          </p>

          <!-- CTA row -->
          <div class="flex flex-col items-center justify-center gap-2">
            <a
              href={getLocalizedPath('/free-consultation', lang)}
              class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-lg hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg text-sm lg:text-base"
            >
              Request a Free Consultation
            </a>
            <a
              href="tel:+3613009414"
              class="inline-flex items-center gap-2 text-base lg:text-lg text-[#c53f75] font-bold hover:text-[#a33460] transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +36 1 300 9414
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: Hero image -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2 relative overflow-hidden min-h-[300px] lg:min-h-0">
        <ContentImage
          src={greenSeaPeelHero}
          alt="Green Sea Peel treatment Budapest"
          class="w-full h-full object-cover"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:hidden"></div>

        <!-- Google Rating Badge -->
        <div class="absolute bottom-3 left-3 lg:bottom-5 lg:left-5 bg-white/95 backdrop-blur-sm rounded-xl shadow-xl p-2 lg:p-3">
          <div class="flex items-center gap-2">
            <FixedImage src={googleLogo} alt="Google" width={36} height={36} class="w-7 h-7 lg:w-9 lg:h-9 rounded-full" />
            <div>
              <div class="flex items-center gap-1">
                <span class="text-base lg:text-xl font-bold text-gray-900 rating-number" data-target="5.0">0</span>
                <div class="flex">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-2.5 h-2.5 lg:w-3.5 lg:h-3.5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
              <p class="text-[9px] lg:text-[11px] text-gray-600">Based on Google reviews</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="w-full bg-gradient-to-r from-[#c53f75] to-[#a33460] py-4 lg:h-[80px] flex-shrink-0 flex items-center justify-center">
      <div class="max-w-[1000px] mx-auto px-4 w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-8 h-full items-center">
          {stats.map((stat, index) => (
            <div class="text-center stat-item py-2 lg:py-0" style={`animation-delay: ${index * 100}ms`}>
              <p class="text-[24px] lg:text-[32px] font-heading text-white font-bold leading-[0.9] mb-1">
                {stat.value}
              </p>
              <p class="text-white/80 text-[12px] lg:text-[16px] leading-[0.9]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section with Fanni -->
  <section class="section-animate py-12 lg:py-16 bg-gradient-to-br from-[#fdf8f6] via-[#fff] to-[#f8f4f9]">
    <div class="max-w-[1100px] mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <!-- Image -->
          <div class="w-full lg:w-2/5 flex-shrink-0 relative">
            <ContentImage
              src={konyaFanniSzepsegszalon}
              alt="Fanni Kónya, Green Sea Peel specialist"
              class="w-full h-auto lg:absolute lg:inset-0 lg:h-full object-cover object-top"
            />
            <!-- Mobile signature -->
            <div class="lg:hidden flex items-center gap-3 p-4 bg-gray-50 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold text-sm mb-0">Fanni Kónya</p>
                <p class="text-gray-500 text-xs mb-0">managing director</p>
              </div>
            </div>
          </div>
          <!-- Text content -->
          <div class="w-full lg:w-3/5 p-6 lg:p-8 flex flex-col justify-center">
            <p class="text-gray-700 mb-5 leading-relaxed" style="font-size: 18px;">
              No matter how diligently you use the best creams every day, pigmentation spots, acne scars, and dull skin just won't go away? That's because these problems are in the deeper layers of the skin – and traditional skincare simply cannot reach there.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              Green Sea Peel is a premium Korean exfoliation treatment in which <strong>sea sponge micro-needles penetrate deep into the skin</strong> and trigger natural cell regeneration. I tried two brands before deciding: Korea is the leader of the cosmetic industry, so I chose KRX Aesthetics – it costs five times more than cheaper alternatives, but the results are incomparable.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              I tried it on myself first. Already during the treatment, I felt how <strong>blood circulation kicked in, cell regeneration started immediately</strong>, and afterwards I was incredibly thirsty – it also stimulated lymphatic circulation. After the treatment, the old, damaged skin peels off in sheets, and underneath <strong>fresh, renewed, pigmentation-free skin appears</strong>. It's as if you get completely new skin.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              This treatment is not a facial cleansing procedure like Hydratouch, and it's not a mild exfoliation like Carbon Peeling. <strong>This is an intensive, deep-layer skin renewal treatment</strong> that works wonders on scarred, pigmented, and ageing skin alike. We are accessible with our two salons in Budapest's 11th and 13th districts.
            </p>
            <p class="text-gray-700 mb-6 text-base leading-relaxed">
              <strong>If you're tired of pigmentation spots, acne scars, or simply want your skin to look youthful and radiant again – Green Sea Peel is the most effective solution you can try.</strong>
            </p>
            <!-- Desktop signature -->
            <div class="hidden lg:flex items-center gap-3 pt-4 border-t border-gray-200">
              <div class="w-12 h-12 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold mb-0">Fanni Kónya</p>
                <p class="text-gray-500 text-sm mb-0">managing director</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 1: Skin Renewal - Image left, Text right -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
          src={greenSeaPeelFeature}
          alt="Green Sea Peel skin renewal"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">
            Complete skin renewal in a single treatment
          </h2>
          <p class="text-gray-700 mb-4">
            Green Sea Peel is not a simple exfoliation – it is a deep-layer skin renewal procedure, not without reason called a "liquid micro-needle." The treatment is based on <strong>Spongilla Spicules</strong> technology: natural sea sponge micro-needles made of calcium carbonate and silicon dioxide, showing a sharp spiny structure under the microscope.
          </p>
          <p class="text-gray-700 mb-4">
            These bio micro-needles <strong>open millions of microchannels in the skin</strong>, stimulate microcirculation, boost collagen production, and trigger cell regeneration. Active ingredients – including hyaluronic acid, allantoin, and copper tripeptide – <strong>reach the deepest layers of the skin</strong> through the opened channels.
          </p>
          <p class="text-gray-700 mb-6">
            The result is dramatic: your skin is literally replaced. Even after a single treatment, complete skin renewal is noticeable – the old, damaged layer peels off, and fresh, healthy skin appears underneath. That's exactly why <strong>those who try it once become hooked</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 2: Pigmentation - Text left, Image right -->
  <section class="section-animate bg-gray-50">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 order-2 lg:order-1">
        <div class="px-5 lg:px-[10%] text-left">
          <h2 class="font-heading text-[2rem] text-gray-900 mb-4 uppercase">
            Say goodbye to pigmentation spots – across the entire face
          </h2>
          <p class="text-gray-700 mb-4">
            Laser pigmentation removal only works locally, on individual spots – and can cause scarring. Green Sea Peel, on the other hand, <strong>renews the entire facial skin at once</strong>: it is a facial renewal treatment in which pigmentation spots naturally come off along with the peeling skin layer.
          </p>
          <p class="text-gray-700 mb-4">
            The treatment is also effective for <strong>age spots, sun spots, and uneven skin tone</strong>. Since it utilises the skin's natural self-healing mechanism, the process is gentle and does not cause scarring – unlike laser procedures.
          </p>
          <p class="text-gray-700 mb-6">
            I've seen such incredible before-and-after photos of this treatment that I immediately decided: we must use the premium version, not the cheaper one. <strong>The pigmentation spots really are completely "erased" from the skin</strong> – and the effect is lasting if you maintain sun protection.
          </p>
          <div class="text-center">
            <a
              href={getLocalizedPath('/free-consultation', lang)}
              class="inline-block px-6 py-3 bg-[#c53f75] text-white font-semibold uppercase text-sm rounded-lg hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg"
            >
              Request a Free Consultation
            </a>
          </div>
        </div>
      </div>
      <div class="w-full lg:w-1/2 relative overflow-hidden order-1 lg:order-2">
        <ContentImage
          src={greenSeaPeelOldHero}
          alt="Green Sea Peel pigmentation spot removal"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
    </div>
  </section>

  <!-- Benefits Section 3: Scars - Image left, Text right -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
          src={greenSeaPeelEgyAlkalom}
          alt="Green Sea Peel acne scar treatment - before and after"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
        <!-- Before / After labels - left=before, right=after -->
        <div class="absolute inset-0 flex pointer-events-none">
          <div class="w-1/2 flex items-end justify-center pb-3 lg:pb-5">
