---
/**
 * /bortipus/[slug] — a 16 publikus Baumann-bőrtípus-oldal egyetlen sablonból.
 *
 * Statikusan generált (prerender), `getStaticPaths` a 16 kódból. Az adat a
 * src/data/baumannTypes.ts single source of truth-ból jön. A tartalom a
 * Baumann-rendszer tényeiből készült (nem fordítás), kozmetikai nyelvezettel.
 *
 * A 4 tengely MÉLY magyarázata a hubon (/bortipus) él — innen csak linkelünk rá,
 * hogy ne legyen 16-szoros duplikáció.
 */
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { baumannTypes, AXIS_LABELS, type AxisLetter } from '../../data/baumannTypes';

export function getStaticPaths() {
  return baumannTypes.map((t) => ({ params: { slug: t.slug }, props: { type: t } }));
}

const { type } = Astro.props;
if (!type) return Astro.redirect('/bortipus');

const t = type;
const url = `https://beautyflow.pro/bortipus/${t.slug}`;

// A 4 tengely kiválasztott betűi a chip-sorhoz.
const axisChips: AxisLetter[] = [t.axes.OD, t.axes.SR, t.axes.PN, t.axes.WT];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${t.code} bőrtípus — ${t.displayName}`,
  description: t.metaDescription,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Person', name: 'Kónya Fanni', jobTitle: 'Kozmetikus' },
  publisher: {
    '@type': 'Organization',
    name: 'BeautyFlow',
    logo: { '@type': 'ImageObject', url: 'https://beautyflow.pro/images/Beautyflow-favicon.png' },
  },
  inLanguage: 'hu',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Főoldal', item: 'https://beautyflow.pro/' },
    { '@type': 'ListItem', position: 2, name: 'Bőrtípusok', item: 'https://beautyflow.pro/bortipus' },
    { '@type': 'ListItem', position: 3, name: t.code, item: url },
  ],
};
---

<Layout title={t.metaTitle} description={t.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="max-w-3xl mx-auto px-5 sm:px-6 py-10 sm:py-14">
    <!-- Breadcrumb -->
    <nav class="text-sm text-[#6f676e] mb-6" aria-label="Útvonal">
      <a href="/" class="hover:text-[#c53f75]">Főoldal</a>
      <span class="mx-1.5">/</span>
      <a href="/bortipus" class="hover:text-[#c53f75]">Bőrtípusok</a>
      <span class="mx-1.5">/</span>
      <span class="text-[#334155]">{t.code}</span>
    </nav>

    <!-- Fejléc -->
    <header class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-[#c53f75] mb-2">
        A te bőrtípusod · {t.code}
      </p>
      <h1 class="font-heading text-3xl sm:text-4xl text-[#1e293b] leading-tight mb-5">
        {t.displayName}
      </h1>
      <!-- Tengely-chipek → hub -->
      <a href="/bortipus#a-4-tulajdonsag" class="no-underline">
        <div class="flex flex-wrap gap-2">
          {axisChips.map((letter) => (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#fff9f7] border border-[#e7d8df] px-3 py-1 text-sm text-[#334155]">
              <strong class="text-[#c53f75]">{letter}</strong>
              {AXIS_LABELS[letter]}
            </span>
          ))}
        </div>
      </a>
    </header>

    <!-- Törzs: szekciók -->
    <div class="space-y-9">
      {t.sections.map((s) => (
        <section>
          <h2 class="font-heading text-2xl text-[#1e293b] mb-3">{s.heading}</h2>
          {s.paragraphs?.map((p) => (
            <p class="text-[#334155] leading-relaxed mb-3 last:mb-0">{p}</p>
          ))}
          {(s.doList || s.dontList) && (
            <div class="grid sm:grid-cols-2 gap-4 mt-2">
              {s.doList && (
                <div class="rounded-xl bg-[#f4faf5] border border-[#d6ebd9] p-4">
                  <p class="text-sm font-semibold uppercase tracking-wide text-[#3f8a4c] mb-2">Érdemes</p>
                  <ul class="list-disc pl-5 space-y-1.5 text-[#334155]">
                    {s.doList.map((d) => <li>{d}</li>)}
                  </ul>
                </div>
              )}
              {s.dontList && (
                <div class="rounded-xl bg-[#fdf3f3] border border-[#f0d6d6] p-4">
                  <p class="text-sm font-semibold uppercase tracking-wide text-[#b3474b] mb-2">Kerüld</p>
                  <ul class="list-disc pl-5 space-y-1.5 text-[#334155]">
                    {s.dontList.map((d) => <li>{d}</li>)}
                  </ul>
                </div>
              )}
            </div>
          )}
          {s.treatments && (
            <ul class="mt-3 space-y-2">
              {s.treatments.map((tr) => (
                <li class="flex gap-2 text-[#334155]">
                  <span class="text-[#c53f75] mt-1">●</span>
                  <span><strong class="text-[#1e293b]">{tr.name}</strong> — {tr.note}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>

    <!-- Előtte/utána (valódi vendég + hozzájárulás; lásd komponens) -->
    {t.beforeAfter && <BeforeAfter typeName={t.code} />}

    <!-- CTA -->
    <section class="mt-12 rounded-2xl bg-[#c53f75] text-white p-7 sm:p-9 text-center">
      <h2 class="font-heading text-2xl sm:text-3xl mb-3">A következő lépés</h2>
      <p class="text-white/90 max-w-xl mx-auto mb-2 leading-relaxed">
        A bőrtípusod megismerése az első fele a történetnek — a másik fele, hogy élőben lássuk,
        mit kér épp most a bőröd.
      </p>
      <p class="text-white/90 max-w-xl mx-auto mb-6 leading-relaxed">
        A <strong>bőrdiagnosztika</strong> mindkét szalonunkban 60 perc, díja
        <strong>10 000 Ft — amit levonunk az első kezelésed árából</strong>, így ha nálunk
        folytatod, gyakorlatilag ingyen van.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/bordiagnosztika" data-track="booking_click" data-source={`bortipus_${t.slug}`}
          class="inline-block px-7 py-3 bg-white text-[#c53f75] font-semibold uppercase tracking-wide rounded-full hover:scale-105 transition-transform">
          Kérem a bőrdiagnosztikát
        </a>
        <a href="/boranalizis" class="inline-block px-7 py-3 border-2 border-white text-white font-semibold uppercase tracking-wide rounded-full hover:bg-white/10 transition-colors">
          Újra kitöltöm a tesztet
        </a>
      </div>
    </section>

    <!-- Disclaimer -->
    <p class="mt-6 text-sm text-[#6f676e] leading-relaxed">
      ⚠️ Ez egy automatikus, tájékoztató eredmény az online válaszaid alapján, és nem helyettesíti
      a személyes bőrdiagnosztikát. Terhesség, szoptatás, friss botox/filler vagy rendszeres gyógyszer
      esetén bizonyos kezelések kimaradnak vagy várni kell velük — ezt a konzultáción egyeztetjük.
    </p>

    <AuthorBox variant="compact" />

    <!-- Belső linkek -->
    <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-[#c53f75] font-semibold">
      <a href="/bortipus" class="hover:underline">← Mi az a 16 bőrtípus?</a>
      <a href={`/bortipus/${t.neighbor.slug}`} class="hover:underline">
        Hozzád közeli: {t.neighbor.code} →
      </a>
    </nav>
  </article>
</Layout>
