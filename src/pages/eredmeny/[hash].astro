---
/**
 * /eredmeny/[hash] — a személyre szabott bőrprofil + javasolt IRÁNY.
 *
 * Csak a kontakt beküldése után érhető el értelmesen (kapu).
 * Az eredmény forrása sorrendben:
 *   1. KV (QUIZ_RESULTS) — ha be van kötve (cross-device, email-link).
 *      JELENLEG NINCS bekötve (wrangler.jsonc), a kódút kész.
 *   2. localStorage / sessionStorage (ugyanazon az eszközön) — a kvíz a beküldés
 *      után ide menti az eredményt, majd ide navigál (KV nélkül is működik).
 *   3. Őszinte fallback: ezen az eszközön nem érhető el → e-mail / visszahívás.
 *
 * Az eredmény IRÁNY, NEM diagnózis (kötelező figyelmeztetés a UI-ban).
 */
import QuizLayout from '../../layouts/QuizLayout.astro';
import { isValidResultHash } from '../../quiz/lib/hash';
import { t } from '../../quiz/lib/i18n';
import type { StoredQuizResult } from '../../quiz/lib/result-store';
import { env as cfEnv } from 'cloudflare:workers';

export const prerender = false;

const { hash } = Astro.params;
const validHash = typeof hash === 'string' && isValidResultHash(hash);

// KV olvasás, ha a binding be van kötve (lásd wrangler.jsonc TODO).
// Astro 6 / @astrojs/cloudflare v13: a binding a `cloudflare:workers`
// env modulból jön (a régi Astro.locals.runtime.env már dob).
let serverResult: StoredQuizResult | null = null;
if (validHash) {
  const kv = (cfEnv as Record<string, unknown>).QUIZ_RESULTS as { get?: (k: string, t: 'json') => Promise<unknown> } | undefined;
  if (kv?.get) {
    try {
      serverResult = (await kv.get(hash as string, 'json')) as StoredQuizResult | null;
    } catch { /* best-effort — fallback localStorage-ra */ }
  }
}

const PHONE = '+36 1 300 9414';
const PHONE_HREF = 'tel:+3613009414';
const CALLBACK_HREF = '/ingyenes-konzultacio';
---

<QuizLayout title="A bőrprofilod | Beautyflow">
  <div id="result-root" class="mx-auto w-full max-w-2xl px-4 py-8" data-hash={validHash ? hash : ''}>
    {serverResult && (
      <script id="quiz-result-data" type="application/json" set:html={JSON.stringify(serverResult)} is:inline />
    )}

    <!-- Tartalom ide renderelődik kliensoldalon (#result-body) -->
    <div id="result-body"></div>

    <!-- Fallback: nincs adat ezen az eszközön. ŐSZINTE szöveg: a cross-device
         eredmény-tároló (KV) nincs bekötve, így innen tényleg nem tudjuk megmutatni
         — nem ígérjük, hogy „úton van". -->
    <div id="result-fallback" class="hidden rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-sm">
      <h1 class="font-heading mb-3 text-2xl text-gray-900">Az eredmény ezen az eszközön nem érhető el</h1>
      <p class="text-gray-600">{t('result.notFound')}</p>
      <div class="mt-5 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href={CALLBACK_HREF} class="inline-block rounded-full bg-[#c53f75] px-6 py-3 font-semibold text-white hover:bg-[#a33460]">
          Visszahívást kérek
        </a>
        <a href={PHONE_HREF} class="inline-block rounded-full border-2 border-[#c53f75] px-6 py-2.5 font-semibold text-[#c53f75] hover:bg-[#c53f75]/5">
          Hívj minket: {PHONE}
        </a>
      </div>
    </div>
  </div>
</QuizLayout>

<script>
  import { loadQuizResult, isStoredQuizResult, type StoredQuizResult } from '@/quiz/lib/result-store';
  import { hasAnalyticsConsent } from '@tracking/lib';
  import { resultHtml, pushResultViewOnce } from '@/quiz/lib/result-view';

  function render(r: StoredQuizResult, hash: string) {
    const body = document.getElementById('result-body')!;
    body.innerHTML = resultHtml(r);
    body.classList.remove('hidden');
    // Analytics-consented view event (browser dataLayer → GTM/GA4), hash-enként egyszer.
    pushResultViewOnce(r, hash, hasAnalyticsConsent());
  }

  function init() {
    const root = document.getElementById('result-root');
    if (!root) return;
    const hash = root.dataset.hash || '';

    let data: StoredQuizResult | null = null;
    const embedded = document.getElementById('quiz-result-data');
    if (embedded?.textContent) {
      try {
        const parsed = JSON.parse(embedded.textContent) as unknown;
        if (isStoredQuizResult(parsed)) data = parsed;
      } catch { /* ignore */ }
    }
    if (!data && hash) data = loadQuizResult(hash);

    if (data) {
      render(data, hash);
    } else {
      document.getElementById('result-fallback')?.classList.remove('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
