---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import LocationsSection from '../components/LocationsSection.astro';
import { ContentImage, CardImage, HeroImage, FixedImage } from '../components/images';

// Image imports
import biopenHero from '../assets/images/biopen-hero.png';
import biopenNewHero from '../assets/images/biopen-new-hero.jpg';
import biopenKezelesKozben from '../assets/images/biopen-feature-1.png';
import biopenEredmeny from '../assets/images/biopen-feature-2.png';
import biopenHatoanyag from '../assets/images/hydrabeauty.jpg'; // PLACEHOLDER
import biopenRancokKezeles from '../assets/images/biopen-rancok-kezeles.jpg';
import biopenHatter from '../assets/images/biopen-hogyan-mukodik.jpg';
import konyaFanniSzepsegszalon from '../assets/images/Konya-Fanni-szepsegszalon.jpg';
import konyaFanniSzepsegszalonja from '../assets/images/konya-fanni-szepsegszalonja.jpg';
import konyaFanniKonzultacio from '../assets/images/konya-fanni-konzultacio.webp';
import notinoIkon from '../assets/images/notino-ikon.png';
import googleLogo from '../assets/images/google-logo.jpg';
import higienia from '../assets/images/higienia.jpg';
import testmeret from '../assets/images/testmeret.jpg';
import nyitva from '../assets/images/nyitva.jpg';
import notinoLogoSm from '../assets/images/logok/notino-logo-sm.jpg';
import skinlab from '../assets/images/logok/skinlab.webp';
import biopenMikrotusVsSima from '../assets/images/biopen-mikrotus-vs-sima.jpg';
import hydrabeautyArckezelesBeautyflow from '../assets/images/hydrabeauty-arckezeles-beautyflow.jpg'; // PLACEHOLDER
import mestersegesIntelligencia from '../assets/images/mesterseges-intelligencia-szortelenito-gep.jpg';

const stats = [
  { value: '10+ év', label: 'tapasztalat' },
  { value: '75', label: 'perces kezelés' },
  { value: '20+', label: 'hatóanyag' },
  { value: '25+', label: 'éves kortól' },
];

const testimonials = [
  {
    text: 'A Biopen Q2 kezelés után a bőröm sokkal feszesebbnek és fiatalabbnak tűnik. A mimikai ráncaim láthatóan halványultak, és a bőröm textúrája is javult. Nagyon elégedett vagyok!',
    author: 'Andrea',
  },
  {
    text: 'Évek óta kerestem egy hatékony anti-aging megoldást. A mikrotűs kezelés fájdalommentes volt az érzéstelenítésnek köszönhetően, az eredmény pedig lenyűgöző. A bőröm ragyog!',
    author: 'Tímea',
  },
  {
    text: 'A szemkörnyékem mindig problémás volt – fáradt, petyhüdt. Kónya Fanni a Biopen Q2-vel célzottan kezelte, és már az első alkalom után éreztem a különbséget. Visszajáró vendég lettem!',
    author: 'Nóra',
  }
];

const singlePrices = [
  { area: 'Biopen arckezelés', price: '30 000 Ft', description: '60 perc – személyre szabott hatóanyagokkal' },
  { area: 'Biopen KRX – Hialuron porral', price: '35 000 Ft', description: '75 perc – intenzív hidratálás, regeneráció' },
  { area: 'Biopen KRX – B.tox ampullával', price: '35 000 Ft', description: '75 perc – simább, feszesebb bőrért' },
  { area: 'Biopen KRX – Thread fillel', price: '45 000 Ft', description: '90 perc – felszívódó kollagénszálakkal' },
];

const packages: { area: string; originalPrice: string; price: string; discount: string }[] = [];

const howItWorks = [
  {
    number: '1.',
    title: 'Konzultáció és érzéstelenítés',
    description: 'Felmérjük a bőröd állapotát, kiválasztjuk a megfelelő hatóanyagokat, majd lidokainos krémmel érzéstelenítjük a kezelendő területet a fájdalommentes élmény érdekében.'
  },
  {
    number: '2.',
    title: 'Mikrotűs mezoterápia',
    description: 'A Biopen Q2 mikrotűi mikrocsatornákat nyitnak a bőrben, miközben orvosi tisztaságú hatóanyagokat juttatnak a mélyrétegekbe. Beindítják a kollagén és elasztin termelést.'
  },
  {
    number: '3.',
    title: 'Elektroporáció és LED',
    description: 'Az elektroporáció fokozza a hatóanyag-felszívódást, a LED fényterápia (kék vagy piros) pedig célzottan kezeli az adott bőrproblémát – akné vagy anti-aging.'
  },
  {
    number: '4.',
    title: 'Lezárás és utóápolás',
    description: 'Nyugtató szérummal és fényvédővel zárjuk a kezelést. Részletesen átbeszéljük az otthoni utóápolást, hogy az eredmény tartós legyen.'
  }
];

const faqs = [
  { question: 'Mi az a Biopen Q2?', answer: 'A Biopen Q2 egy 3-in-1 kozmetikai készülék, amely mikrotűs mezoterápiát, elektroporációt és LED fényterápiát ötvöz egyetlen kezelésben. Orvosi tisztaságú hatóanyagokat juttat a bőr mélyrétégeibe, beindítva a kollagén és elasztin termelést.' },
  { question: 'Fájdalmas a kezelés?', answer: 'Nem. A kezelés előtt lidokainos érzéstelenítő krémet alkalmazunk, így a mikrotűs kezelés fájdalommentes. Az elektroporáció enyhe áramérzetet adhat, de ez kikapcsolható, ha kellemetlen.' },
  { question: 'Kinek ajánlott a Biopen Q2?', answer: '25 éves kor felett ajánljuk, amikor a természetes kollagéntermelés lelassul. Kiváló ráncokra, hegekre, pigmentfoltokra, dehidratált bőrre, tágpórusokra és szemkörnyék problémákra.' },
  { question: 'Milyen hatóanyagokkal dolgoztok?', answer: '20-féle orvosi tisztaságú ampullával dolgozunk: kollagén, hialuronsav, C-vitamin, peptidek, lifting hatóanyagok, és speciális keverékek dehidratált, pigmentfoltos vagy aknés bőrre.' },
  { question: 'Hány kezelés szükséges?', answer: 'Már az első kezelés után látható javulás tapasztalható. Optimális eredményhez 4 alkalmas kúra javasolt, 3-4 hetente. Utána évente 1-2 fenntartó kezelés elegendő.' },
  { question: 'Mikor végezhető a kezelés?', answer: 'Télen mikrotűvel dolgozunk (mélyebb rétegek), nyáron nanotűvel (felszíni kezelés). Így egész évben végezhető, a szezonhoz igazítva az intenzitást.' },
  { question: 'Mi a különbség a mikrotű és a nanotű között?', answer: 'A mikrotű mélyebb rétegekbe hatol, intenzívebb eredményt ad – ezt télen alkalmazzuk. A nanotű a felszíni rétegekben dolgozik, kíméletesebb, nyáron is biztonságos.' },
  { question: 'Kombinálható más kezelésekkel?', answer: 'A Biopen Q2 önmagában komplex kezelés, amelyet nem kombinálunk más elektrokozmetikai eljárásokkal. A készülék 3 funkciója (mikrotű, elektroporáció, LED) egymást erősíti.' },
  { question: 'Van-e leállási idő?', answer: 'Minimális. A kezelés után enyhe pirosság jelentkezhet, ami néhány órán belül elmúlik. Másnap már normálisan folytathatod a napirendedet.' },
  { question: 'Miért érdemes a Beautyflow-ba jönni?', answer: 'Mi 75 perces kezelést végzünk érzéstelenítéssel, 20-féle orvosi tisztaságú hatóanyaggal dolgozunk, és a LED fényterápiát az árban benne foglaljuk. Díjnyertes szalonunkban a prémiumból is a prémiumot kapod.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title="Biopen Q2 Mikrotűs Mezoterápia Budapest - Bőrfiatalítás | Beautyflow"
  description="Biopen Q2 mikrotűs mezoterápia Budapesten. 3-in-1 kezelés: mikrotű + elektroporáció + LED fényterápia. 20-féle orvosi tisztaságú hatóanyag, 75 perces luxus program. Kérj ingyenes konzultációt!"
  ogImage="/images/hydrabeauty-arckezeles.jpg"
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Főoldal",
        "item": "https://beautyflow.pro/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Biopen Q2 Kezelés",
        "item": "https://beautyflow.pro/biopen-q2"
      }
    ]
  })} />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Biopen Q2 Mikrotűs Mezoterápia",
    "name": "Biopen Q2 Kezelés Budapest",
    "description": "Biopen Q2 mikrotűs mezoterápia Budapesten. 3-in-1 kezelés: mikrotű + elektroporáció + LED fényterápia. Orvosi tisztaságú hatóanyagokkal.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Beautyflow Szépségszalon",
      "image": "https://beautyflow.pro/images/beautyflow-logo.png",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Vegyész u. 1.",
          "addressLocality": "Budapest",
          "postalCode": "1116",
          "addressCountry": "HU"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Reitter Ferenc u. 90.",
          "addressLocality": "Budapest",
          "postalCode": "1135",
          "addressCountry": "HU"
        }
      ],
      "telephone": "+36 1 300 9414",
      "priceRange": "$$$"
    },
    "areaServed": {
      "@type": "City",
      "name": "Budapest"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Biopen Q2 szolgáltatások",
      "itemListElement": singlePrices.map(item => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": item.area
        },
        "price": item.price.replace(/[^0-9]/g, ''),
        "priceCurrency": "HUF"
      }))
    }
  })} />

  <!-- Hero Section -->
  <section class="hero-section relative lg:h-[calc(100dvh-60px)] flex flex-col">
    <div class="flex flex-col lg:flex-row flex-1 min-h-0">
      <!-- Left column: Text content -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center py-6 lg:py-8 order-2 lg:order-1 bg-[#fff9f7]">
        <div class="w-full px-[6%] text-center">
          <!-- Notino Award Badge -->
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full blur-sm opacity-50"></div>
              <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500 p-1 rounded-full">
                <div class="bg-white rounded-full p-1">
                  <FixedImage
                    src={notinoIkon}
                    alt="Notino"
                    width={32}
                    height={32}
                    class="w-8 h-8"
                  />
                </div>
              </div>
            </div>
            <div class="text-left">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Díjnyertes szalon</span>
              </div>
              <span class="text-sm font-bold text-[#c53f75]">Notino "Hónap Szalonja"</span>
            </div>
          </div>

          <h1 class="text-[#c53f75] font-semibold uppercase tracking-wider text-sm lg:text-base mb-2">
            Biopen Q2 mikrotűs mezoterápia Budapesten
          </h1>
          <h2 class="font-heading text-[1.75rem] lg:text-[2.25rem] text-gray-900 mb-3 uppercase leading-tight">
            Fiatalítsd meg a bőröd a mélyrétegekből
          </h2>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-lg mx-auto">
            3-in-1 kezelés: mikrotű + elektroporáció + LED fényterápia. 20-féle orvosi tisztaságú hatóanyaggal, a te bőrproblémádra szabva.
          </p>

          <!-- CTA row -->
          <div class="flex flex-col items-center justify-center gap-2">
            <a
              href="/ingyenes-konzultacio"
              class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg text-sm lg:text-base"
            >
              Foglalj időpontot most!
            </a>
            <a
              href="tel:+3613009414"
              class="inline-flex items-center gap-2 text-base lg:text-lg text-[#c53f75] font-bold hover:text-[#a33460] transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +36 1 300 9414
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: Hero image -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2 relative overflow-hidden min-h-[300px] lg:min-h-0">
        <ContentImage
          src={biopenNewHero}
          alt="Biopen Q2 mikrotűs mezoterápia Budapest"
          class="w-full h-full object-cover"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:hidden"></div>

        <!-- Google Rating Badge -->
        <div class="absolute bottom-3 left-3 lg:bottom-5 lg:left-5 bg-white/95 backdrop-blur-sm rounded-xl shadow-xl p-2 lg:p-3">
          <div class="flex items-center gap-2">
            <FixedImage
              src={googleLogo}
              alt="Google"
              width={36}
              height={36}
              class="w-7 h-7 lg:w-9 lg:h-9 rounded-full"
            />
            <div>
              <div class="flex items-center gap-1">
                <span class="text-base lg:text-xl font-bold text-gray-900 rating-number" data-target="5.0">0</span>
                <div class="flex">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-2.5 h-2.5 lg:w-3.5 lg:h-3.5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
              <p class="text-[9px] lg:text-[11px] text-gray-600">Google értékelés alapján</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="w-full bg-gradient-to-r from-[#c53f75] to-[#a33460] py-4 lg:h-[80px] flex-shrink-0 flex items-center justify-center">
      <div class="max-w-[1000px] mx-auto px-4 w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-8 h-full items-center">
          {stats.map((stat, index) => (
            <div class="text-center stat-item py-2 lg:py-0" style={`animation-delay: ${index * 100}ms`}>
              <p class="text-[24px] lg:text-[32px] font-heading text-white font-bold leading-[0.9] mb-1">
                {stat.value}
              </p>
              <p class="text-white/80 text-[12px] lg:text-[16px] leading-[0.9]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section with Fanni -->
  <section class="section-animate py-12 lg:py-16 bg-gradient-to-br from-[#fdf8f6] via-[#fff] to-[#f8f4f9]">
    <div class="max-w-[1100px] mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <!-- Image -->
          <div class="w-full lg:w-2/5 flex-shrink-0 relative">
            <ContentImage
              src={konyaFanniSzepsegszalon}
              alt="Kónya Fanni Biopen Q2 szakértő"
              class="w-full h-auto lg:absolute lg:inset-0 lg:h-full object-cover object-top"
            />
            <!-- Mobile signature -->
            <div class="lg:hidden flex items-center gap-3 p-4 bg-gray-50 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold text-sm mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-xs mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
          <!-- Text content -->
          <div class="w-full lg:w-3/5 p-6 lg:p-8 flex flex-col justify-center">
            <p class="text-gray-700 mb-5 leading-relaxed" style="font-size: 18px;">
              25 éves kor után a természetes kollagéntermelésünk lelassul – innentől abból dolgozunk, amink van. Ezért nem elég a napi kencézés: a hatóanyagoknak a bőr mélyrétegeibe kell jutniuk, hogy valódi változást hozzanak. Pontosan erre való a Biopen Q2.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              Ez egy <strong>mikrotűs mezoterápiás készülék, amely orvosi tisztaságú hatóanyagokkal</strong> dolgozik. A mikrotűk mikrocsatornákat nyitnak a bőrben, beindítják a kollagén és elasztin termelést, miközben a hatóanyagok – legyen az hialuronsav, peptid, C-vitamin vagy kollagén – a bőr legmélyebb rétegeibe jutnak.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              De a Biopen Q2 nem csak mikrotű – <strong>elektroporáció és LED fényterápia is beépítve van</strong> a készülékbe. Az elektroporáció fokozza a hatóanyag-felszívódást, a kék LED az aknés bőrt kezeli, a piros LED pedig az anti-aging hatást erősíti. Három funkció, egy készülék, egy kezelés.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              20-féle orvosi tisztaságú ampullával dolgozunk – <strong>nincs olyan bőrprobléma, amire ne tudnánk megoldást nyújtani</strong>. Ráncok, hegek, pigmentfoltok, dehidratáció, tágpórusok, szemkörnyék – mindenre van a megfelelő hatóanyag-kombináció.
            </p>
            <p class="text-gray-700 mb-6 text-base leading-relaxed">
              <strong>Ha érzed, hogy a bőröd nem az, ami volt, és a krémek már nem elégek – a Biopen Q2 mikrotűs mezoterápia a következő szint.</strong>
            </p>
            <!-- Desktop signature -->
            <div class="hidden lg:flex items-center gap-3 pt-4 border-t border-gray-200">
              <div class="w-12 h-12 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-sm mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 1: Anti-aging - Image left, Text right -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
          src={biopenHero}
          alt="Biopen Q2 anti-aging kezelés - ráncok és öregedés ellen"
          class="w-full h-64 lg:h-full object-cover transition-transform duration-700 hover:scale-105"
        />
      </div>
      <div class="w-full lg:w-1/2 flex items-center py-12 lg:py-16 bg-white">
