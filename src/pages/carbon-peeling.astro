---
export const prerender = true;

import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LocationsSection from '../components/LocationsSection.astro';
import ContentImage from '../components/images/ContentImage.astro';
import CardImage from '../components/images/CardImage.astro';
import HeroImage from '../components/images/HeroImage.astro';

// Import images
import carbonPeelingFo from '../assets/images/carbon-peeling-fo.jpg';
import carbonPeelingArchamlasztas from '../assets/images/carbon-peeling-archamlasztas.jpg';
import carbonPeelingLezeres from '../assets/images/carbon-peeling-lezeres.jpg';
import carbonPeelingMb from '../assets/images/carbon-peeling-mb.jpg';
import carbonPeelingTetovalas from '../assets/images/carbon-peeling-tetovalas.webp';
import szemoldokSminktetovalas from '../assets/images/szemoldok-sminktetovalas.jpg';
import hydrabeautyArckezelesBeautyflow from '../assets/images/hydrabeauty-arckezeles-beautyflow.jpg';
import depositphotosCarbonNanogel from '../assets/images/depositphotos-carbon-nanogel.jpg';
import carbonPeelingHatter from '../assets/images/originals/carbon-peeling-hatter.webp';
import konyaFanniSzepsegszalon from '../assets/images/Konya-Fanni-szepsegszalon.jpg';
import konyaFanniSzepsegszalonja from '../assets/images/konya-fanni-szepsegszalonja.jpg';
import notinoIkon from '../assets/images/notino-ikon.png';
import googleLogo from '../assets/images/google-logo.jpg';
import higienia from '../assets/images/higienia.jpg';
import testmeret from '../assets/images/testmeret.jpg';
import nyitva from '../assets/images/nyitva.jpg';
import notinoLogoSm from '../assets/images/logok/notino-logo-sm.jpg';
import skinlab from '../assets/images/logok/skinlab.webp';
import PhoneLink from '@leadgen/conversion-tracking/components/PhoneLink.astro';

// Generate optimized images for small fixed-size elements (1x + 2x srcset pattern)
const notinoIkonOptimized = await getImage({ src: notinoIkon, width: 64, format: 'webp', quality: 60 });
const notinoIkon1x = await getImage({ src: notinoIkon, width: 32, format: 'webp', quality: 60 });
const googleLogoOptimized = await getImage({ src: googleLogo, width: 72, format: 'webp', quality: 60 });
const googleLogo1x = await getImage({ src: googleLogo, width: 36, format: 'webp', quality: 60 });
const googleLogoSmallOptimized = await getImage({ src: googleLogo, width: 56, format: 'webp', quality: 60 });
const googleLogoSmall1x = await getImage({ src: googleLogo, width: 28, format: 'webp', quality: 60 });
const notinoLogoSmOptimized = await getImage({ src: notinoLogoSm, width: 96, format: 'webp', quality: 60 });
const notinoLogoSm1x = await getImage({ src: notinoLogoSm, width: 48, format: 'webp', quality: 60 });
const skinlabOptimized = await getImage({ src: skinlab, width: 96, format: 'webp', quality: 60 });
const skinlab1x = await getImage({ src: skinlab, width: 48, format: 'webp', quality: 60 });

const notinoUrlBuda = "https://www.notino.hu/szalonok/beautyflow?source_caller=ui&shortlink=lbbsjxf8&c=salon_detail_redirect&pid=notino_partner&deep_link_value=https%3A%2F%2Fnotino.hu%2Fszalonok%2Fbeautyflow&af_xp=custom";
const notinoUrlPest = "https://www.notino.hu/szalonok/beautyflow-pest?source_caller=ui&shortlink=lbbsjxf8&c=salon_detail_redirect&pid=notino_partner&deep_link_value=https%3A%2F%2Fnotino.hu%2Fszalonok%2Fbeautyflow-pest&af_xp=custom";

const stats = [
  { value: '10+ év', label: 'tapasztalat' },
  { value: '60 perc', label: 'kezelés hossza' },
  { value: '100%', label: 'elégedett vendég' },
  { value: '1x', label: 'látványos eredmény' },
];

const testimonials = [
  {
    text: 'Nagyon kedvesek, közvetlenek, igényes munka, a szalon szép, tiszta, otthonosan berendezve, abszolút pozitív élmény volt!',
    author: 'Blanka',
  },
  {
    text: 'Gyönyörű, igényes, tiszta szalon A lányok nagyon kedveves és igényesek munkájukra. Csak ajánlani tudom őket 🙂',
    author: 'Czár Barbara',
  },
  {
    text: 'Szívből ajanlom Fannit és csapatát. Mindenki nagyon profi és kedves. A legjobb döntés volt felkeresni a szalont',
    author: 'Lázár Anita',
  }
];

const singlePrices = [
  { area: 'Pigmentfolt eltávolítás', price: '10 000 Ft' },
  { area: 'Kézfej (mindkettő)', price: '15 000 Ft' },
  { area: 'Hónalj világosítás (mindkettő)', price: '15 000 Ft' },
  { area: 'Szemöldök', price: '15 000 Ft' },
  { area: 'Teljes arc', price: '25 000 Ft' },
  { area: 'Dekoltázs', price: '25 000 Ft' },
  { area: 'Teljes hát', price: '35 000 Ft' },
];

const packages = [
  { area: 'Teljes arc', originalPrice: '125 000', price: '100 000 Ft', discount: '-20%' },
  { area: 'Dekoltázs', originalPrice: '125 000', price: '100 000 Ft', discount: '-20%' },
  { area: 'Teljes arc + nyak + dekoltázs', originalPrice: '200 000', price: '160 000 Ft', discount: '-20%' },
  { area: 'Teljes hát', originalPrice: '175 000', price: '140 000 Ft', discount: '-20%' },
  { area: 'Kézfej (mindkettő)', originalPrice: '75 000', price: '60 000 Ft', discount: '-20%' },
  { area: 'Hónalj világosítás (mindkettő)', originalPrice: '75 000', price: '60 000 Ft', discount: '-20%' },
];

const howItWorks = [
  {
    number: '1.',
    title: 'Ingyenes konzultáció',
    description: 'Először átbeszéljük a bőröd igényeit, és megtervezzük a számodra legelőnyösebb kezelést. Megmutatjuk, hogyan zajlik a carbon peeling, és milyen eredményekre számíthatsz.'
  },
  {
    number: '2.',
    title: 'Előkészítés',
    description: 'A bőrre egy speciális szénpasztát kenünk, amely mélyen behatol a pórusokba. Ez szolgál vezetőanyagként a lézerhez, és segít a faggyútermelés szabályozásában.'
  },
  {
    number: '3.',
    title: 'Lézeres kezelés',
    description: 'A lézer a szénpasztát mikro-lövésekkel összetöri, így eltávolítja a szennyeződéseket és az elhalt hámsejteket. A kezelés összehúzza a pórusokat, csökkenti a gyulladást, és halványítja a pigmentfoltokat.'
  },
  {
    number: '4.',
    title: 'Azonnali eredmény',
    description: 'Már az első kezelés után frissebb, simább és ragyogóbb lesz a bőröd. A pórusok szűkülnek, a bőr textúrája látványosan javul, és a faggyútermelés is normalizálódik, így gyorsan elérhető a "glass skin".'
  }
];

const faqs = [
  { question: 'Mennyire fájdalmas a Carbon Peeling?', answer: 'A kezelés szinte teljesen fájdalommentes. A legtöbb vendégünk csak enyhe melegséget és bizsergést érez a lézer alkalmazása közben.' },
  { question: 'Kinek ajánlott a Carbon Peeling?', answer: 'Zsíros, aknés, tág pórusú, pigmentfoltos vagy fakó bőrűeknek ideális. Kiválóan alkalmas bőrfiatalításra és a bőrtónus javítására is.' },
  { question: 'Hány kezelés szükséges a látványos eredményhez?', answer: 'Már az első kezelés után látványos az eredmény! Az optimális hatásért 4-6 kezelés javasolt, 2-4 hetes időközönként.' },
  { question: 'Milyen az utóápolás?', answer: 'A kezelés után nem szükséges speciális utóápolás. Ajánlott 48 órán belül kerülni az erős napsütést és a szaunázást.' },
  { question: 'Sminkelhetek a kezelés után?', answer: 'Igen, a kezelés után azonnal sminkelhet. Sőt, a sima, tiszta bőrön a smink még szebben mutat!' },
  { question: 'Van-e leállási idő?', answer: 'Nincs! A Carbon Peeling "ebédidő kezelés" - azonnal visszatérhet a mindennapi tevékenységéhez, nincs látható bőrpír vagy hámlás.' },
  { question: 'Terhesség alatt végezhető a kezelés?', answer: 'Terhesség és szoptatás alatt nem javasolt a Carbon Peeling kezelés.' },
  { question: 'Milyen gyakran ismételhető?', answer: 'A kezelés 2-4 hetente ismételhető. Fenntartó kezelésként havonta egyszer elegendő.' },
  { question: 'Miben különbözik más hámlasztó kezeléstől?', answer: 'A Carbon Peeling kíméletes, nincs hámlási időszak, és már az első alkalom után látványos az eredmény. A lézer nem csak tisztít, hanem kollagéntermelést is serkent.' },
  { question: 'Érzékeny bőrre is alkalmas?', answer: 'Igen, a Carbon Peeling kifejezetten kíméletes, érzékeny bőrre is alkalmazható. A konzultáción felmérjük a bőröd állapotát.' },
];
---

<Layout
  title="Carbon Peeling Archámlasztás Budapest - Glass Skin Kezelés | Beautyflow"
  description="Forradalmi Carbon Peeling kezelés Budapesten. Lézeres bőrtisztítás és fiatalítás 60 perces luxus programmal. Glass skin hatás már az első alkalomtól. Kérj ingyenes konzultációt!"
  ogImage="/images/carbon-peeling-fo.jpg"
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Főoldal",
        "item": "https://beautyflow.pro/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Carbon Peeling Archámlasztás",
        "item": "https://beautyflow.pro/carbon-peeling"
      }
    ]
  })} />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Carbon Peeling",
    "name": "Carbon Peeling Archámlasztás Budapest",
    "description": "Forradalmi Carbon Peeling kezelés Budapesten. Lézeres bőrtisztítás és fiatalítás 60 perces luxus programmal.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Beautyflow Szépségszalon",
      "image": "https://beautyflow.pro/images/beautyflow-logo.png",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "Vegyész u. 1.",
          "addressLocality": "Budapest",
          "postalCode": "1116",
          "addressCountry": "HU"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Reitter Ferenc u. 90.",
          "addressLocality": "Budapest",
          "postalCode": "1135",
          "addressCountry": "HU"
        }
      ],
      "telephone": "+36 1 300 9414",
      "priceRange": "$$"
    },
    "areaServed": {
      "@type": "City",
      "name": "Budapest"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Carbon Peeling szolgáltatások",
      "itemListElement": singlePrices.map(item => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": `Carbon Peeling - ${item.area}`
        },
        "price": item.price.replace(/[^0-9]/g, ''),
        "priceCurrency": "HUF"
      }))
    }
  })} />

  <!-- Hero Section -->
  <section class="hero-section relative lg:h-[calc(100dvh-60px)] flex flex-col">
    <div class="flex flex-col lg:flex-row flex-1 min-h-0">
      <!-- Left column: Text content -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center py-6 lg:py-8 order-2 lg:order-1 bg-[#fff9f7]">
        <div class="w-full px-[6%] text-center">
          <!-- Notino Award Badge -->
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full blur-sm opacity-50"></div>
              <div class="relative bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500 p-1 rounded-full">
                <div class="bg-white rounded-full p-1">
                  <img
                    src={notinoIkon1x.src}
                    srcset={`${notinoIkon1x.src} 1x, ${notinoIkonOptimized.src} 2x`}
                    alt="Notino"
                    class="w-8 h-8"
                    width="32"
                    height="32"
                    loading="eager"
                  />
                </div>
              </div>
            </div>
            <div class="text-left">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Díjnyertes szalon</span>
              </div>
              <span class="text-sm font-bold text-[#c53f75]">Notino "Hónap Szalonja"</span>
            </div>
          </div>

          <h1 class="text-[#c53f75] font-semibold uppercase tracking-wider text-sm lg:text-base mb-2">
            Carbon Peeling archámlasztó kezelés Budapesten
          </h1>
          <h2 class="font-heading text-[1.75rem] lg:text-[2.25rem] text-gray-900 mb-3 uppercase leading-tight">
            Forradalmi bőrtisztítás és fiatalítás lézerrel
          </h2>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-lg mx-auto">
            Zsíros, pattanásos, tág pórusú vagy fakó arcbőröd? Kényeztesd vadonatúj kíméletes, de rendkívül hatékony hámlasztó módszerünkkel
          </p>

          <!-- CTA row -->
          <div class="flex flex-col items-center justify-center gap-2">
            <a
              href="/ingyenes-konzultacio"
              class="inline-block px-8 py-3 bg-[#c53f75] text-white font-semibold uppercase tracking-wide rounded-full hover:bg-[#a33460] transition-all duration-300 hover:scale-105 hover:shadow-lg text-sm lg:text-base"
            >
              Foglalj időpontot most!
            </a>
            <PhoneLink phone="+3613009414" class="inline-flex items-center gap-2 text-base lg:text-lg text-[#c53f75] font-bold hover:text-[#a33460] transition-all duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +36 1 300 9414
            </PhoneLink>
          </div>
        </div>
      </div>

      <!-- Right column: Hero image -->
      <div class="w-full lg:w-1/2 order-1 lg:order-2 relative overflow-hidden min-h-[300px] lg:min-h-0">
        <ContentImage
          src={carbonPeelingFo}
          alt="Carbon Peeling Budapest"
          class="w-full h-full object-cover"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent lg:hidden"></div>

        <!-- Google Rating Badge -->
        <div class="absolute bottom-3 left-3 lg:bottom-5 lg:left-5 bg-white/95 backdrop-blur-sm rounded-xl shadow-xl p-2 lg:p-3">
          <div class="flex items-center gap-2">
            <img
              src={googleLogo1x.src}
              srcset={`${googleLogo1x.src} 1x, ${googleLogoOptimized.src} 2x`}
              alt="Google"
              class="w-7 h-7 lg:w-9 lg:h-9 rounded-full"
              width="36"
              height="36"
              loading="eager"
            />
            <div>
              <div class="flex items-center gap-1">
                <span class="text-base lg:text-xl font-bold text-gray-900 rating-number" data-target="5.0">0</span>
                <div class="flex">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-2.5 h-2.5 lg:w-3.5 lg:h-3.5 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
              <p class="text-[9px] lg:text-[11px] text-gray-600">Google értékelés alapján</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="w-full bg-gradient-to-r from-[#c53f75] to-[#a33460] py-4 lg:h-[80px] flex-shrink-0 flex items-center justify-center">
      <div class="max-w-[1000px] mx-auto px-4 w-full">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-8 h-full items-center">
          {stats.map((stat, index) => (
            <div class="text-center stat-item py-2 lg:py-0" style={`animation-delay: ${index * 100}ms`}>
              <p class="text-[24px] lg:text-[32px] font-heading text-white font-bold leading-[0.9] mb-1">
                {stat.value}
              </p>
              <p class="text-white/80 text-[12px] lg:text-[16px] leading-[0.9]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section with Fanni -->
  <section class="section-animate py-12 lg:py-16 bg-gradient-to-br from-[#fdf8f6] via-[#fff] to-[#f8f4f9]">
    <div class="max-w-[1100px] mx-auto px-4">
      <!-- White card containing both image and text -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <!-- Image - full width on mobile, stretch to fill height on desktop -->
          <div class="w-full lg:w-2/5 flex-shrink-0 relative">
            <ContentImage
              src={konyaFanniSzepsegszalon}
              alt="Kónya Fanni Carbon Peeling szakértő"
              class="w-full h-auto lg:absolute lg:inset-0 lg:h-full object-cover object-top"
            />
            <!-- Mobile signature - right below image -->
            <div class="lg:hidden flex items-center gap-3 p-4 bg-gray-50 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold text-sm mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-xs mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
          <!-- Text content -->
          <div class="w-full lg:w-3/5 p-6 lg:p-8 flex flex-col justify-center">
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              Hiába tisztítod és ápolod a bőröd, mégis újra és újra megjelennek a mitesszerek és a makacs pórusok? Ez nem a te hibád – egyszerűen mélyebb tisztításra van szüksége a bőrödnek.
            </p>
            <p class="text-gray-700 mb-5 text-base leading-relaxed">
              A Carbon Peeling ebben segít: az aktív szén és a lézer kombinációja hatékonyan szabadítja meg a pórusaidat a szennyeződésektől, miközben serkenti a kollagéntermelést. Az eredmény? <strong>Friss, sima és feszesebb arcbőr</strong>, ami már az első alkalom után látványosan üdébbnek hat.
            </p>
            <p class="text-gray-700 mb-6 text-base leading-relaxed">
              <strong>Ha eleged van a fakó, problémás bőrből, és szeretnél végre önbizalommal belenézni a tükörbe, a Carbon Peeling kezelés a Beautyflow szalonban a te megoldásod.</strong>
            </p>
            <!-- Desktop signature -->
            <div class="hidden lg:flex items-center gap-3 pt-4 border-t border-gray-200">
              <div class="w-12 h-12 rounded-full bg-[#c53f75]/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-[#c53f75]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div class="leading-tight">
                <p class="text-[#c53f75] font-semibold mb-0">Kónya Fanni</p>
                <p class="text-gray-500 text-sm mb-0">ügyvezető</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section 1: Garantált glass skin - Image left, Text right -->
  <section class="section-animate">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full lg:w-1/2 relative overflow-hidden">
        <ContentImage
