{
  "name": "beautyflow-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro check && astro build && wrangler deploy --keep-vars",
    "cf-typegen": "wrangler types",
    "astro": "astro",
    "check": "astro check",
    "test": "cd tracking-kit && vitest run",
    "test:tracking": "cd tracking-kit && vitest run",
    "typecheck:tracking": "tsc -p tracking-kit/tsconfig.json",
    "generate:gtm": "node tracking-kit/gtm/gen-container.mjs tracking-kit/gtm/container.json && node tracking-kit/gtm/gen-container.mjs tracking/GTM-W8V3BVGD_fixed.json tracking/beautyflow.gtm.json",
    "verify:clickids": "npx tsx scripts/verify-tracking-clickids.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/sitemap": "^3.7.3",
    "@noble/hashes": "^2.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-critters": "^2.2.1",
    "resend": "^6.30.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/cormorant": "^5.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "vite": "^8",
    "sharp": "$sharp",
    "deepmerge-ts": "^8",
    "miniflare": {
      "undici": "^7.29.1"
    }
  }
}
