{
  "name": "beautyflow-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro check && astro build && wrangler deploy --keep-vars",
    "cf-typegen": "wrangler types",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run --root tracking-kit",
    "test:tracking": "vitest run --root tracking-kit",
    "typecheck:tracking": "tsc -p tracking-kit/tsconfig.json",
    "generate:gtm": "node tracking-kit/gtm/gen-container.mjs tracking-kit/gtm/container.json && node tracking-kit/gtm/gen-container.mjs tracking/GTM-W8V3BVGD_fixed.json tracking/beautyflow.gtm.json",
    "verify:clickids": "npx tsx scripts/verify-tracking-clickids.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@noble/hashes": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "astro-critters": "^2.2.1",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource-variable/cormorant": "^5.2.8",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "vite": "^8"
  }
}
